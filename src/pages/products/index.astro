---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import CTABand from '@/components/CTABand.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const parts = (await getCollection('parts')).sort((a, b) => a.data.order - b.data.order);

const categories: Record<string, string> = {
  'power-distribution': 'Power Distribution',
  'motor-control': 'Motor Control',
  'power-quality': 'Power Quality',
  automation: 'Automation',
  capacitor: 'Capacitor',
  custom: 'Custom Engineering',
};
---

<BaseLayout
  title="Electrical Control Panels | Kedar Industries"
  description="Kedar Industries manufactures PCC, MCC, APFC, RTPFC, hybrid power factor, active harmonic filter, static VAR generator and changeover panels. The panels comply with IEC 61439, and the LT panel design is CPRI type-tested."
  path="/products/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Products' }]} />

  <section class="py-14 sm:py-16 section-diagonal-dark section-diagonal-dark--bottom-only">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="Engineered for safety, efficiency & performance"
        title="Our Electrical Panel Solutions"
        lead="Every panel is engineered to IEC 61439, built in-house, and tested before dispatch, from power factor correction panels to a 7400 A PCC panel."
        dark
        align="center"
      />
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <div
        class="flex flex-wrap gap-2 mb-10"
        role="tablist"
        aria-label="Filter products by category"
        id="category-filter"
      >
        <button type="button" class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-ink-900 text-paper" data-filter="all">
          All ({products.length})
        </button>
        {Object.entries(categories).map(([key, label]) => {
          const count = products.filter((p) => p.data.category === key).length;
          return count > 0 ? (
            <button type="button" class="filter-btn px-4 py-2 rounded-full text-sm font-medium bg-ink-100 text-ink-900" data-filter={key}>
              {label} ({count})
            </button>
          ) : null;
        })}
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6" id="product-grid">
        {products.map((product) => (
          <div data-category={product.data.category}>
            <ProductCard
              href={`/products/${product.id}/`}
              name={product.data.name}
              tagline={product.data.tagline}
              heroImage={product.data.heroImage}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="capacitor-parts" class="section-y !pt-4 bg-ink-100/50 scroll-mt-16">
    <div class="container-page">
      <div class="relative mb-10 pb-5 border-b border-ink-200">
        <h2 class="text-2xl sm:text-3xl md:text-[2.25rem] leading-tight text-ink-900">Capacitor Part Fabrication</h2>
        <span class="absolute left-0 -bottom-px h-[3px] w-24 bg-amber-500" aria-hidden="true"></span>
      </div>
      <div class="flex flex-wrap justify-center gap-6">
        {parts.map((part) => (
          <div class="w-full sm:w-[calc(50%-0.75rem)] lg:w-[calc(25%-1.125rem)]">
            <ProductCard
              href={`/capacitor-parts/${part.id}/`}
              name={part.data.name}
              tagline={part.data.tagline}
              heroImage={part.data.heroImage}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand showCall={false} />
</BaseLayout>

<style>
  /* Inactive filter pills get the site-wide bottom-up fill on hover;
     the selected (dark) pill stays as it is. */
  .filter-btn {
    box-shadow: inset 0 0 0 0 var(--color-amber-500);
    transition: box-shadow 0.4s ease-out, color 0.4s ease-out;
  }
  .filter-btn:not(.bg-ink-900):hover,
  .filter-btn:not(.bg-ink-900):focus-visible {
    box-shadow: inset 0 -4em 0 0 var(--color-amber-500);
  }
  @media (prefers-reduced-motion: reduce) {
    .filter-btn {
      transition: none;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#category-filter [data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid [data-category]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.classList.remove('bg-ink-900', 'text-paper'));
      buttons.forEach((b) => b.classList.add('bg-ink-100', 'text-ink-900'));
      btn.classList.remove('bg-ink-100');
      btn.classList.add('bg-ink-900', 'text-paper');

      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
