---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCard from '@/components/ProductCard.astro';
import CTABand from '@/components/CTABand.astro';
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import { img } from '@/lib/images';
import { getCollection } from 'astro:content';

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const parts = (await getCollection('parts')).sort((a, b) => a.data.order - b.data.order);

const categories: Record<string, string> = {
  'power-distribution': 'Power Distribution',
  'motor-control': 'Motor Control',
  'power-quality': 'Power Quality',
  automation: 'Automation',
  capacitor: 'Capacitor',
  custom: 'Custom Engineering',
};
---

<BaseLayout
  title="Electrical Control Panels | Kedar Industries"
  description="Kedar Industries manufactures PCC, MCC, APFC, RTPFC, hybrid power factor, PLC automation, VFD, distribution, and custom electrical control panels — CPRI type-tested, IEC 61439 compliant."
  path="/products/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Products' }]} />

  <section class="py-14 sm:py-16 section-diagonal-dark section-diagonal-dark--bottom-only">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="Engineered for safety, efficiency & performance"
        title="Our Electrical Panel Solutions"
        lead="Every panel is engineered to IEC 61439, built in-house, and tested before dispatch — from small in-feed units to a 7400 A PCC panel."
        dark
        align="center"
      />
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <div
        class="flex flex-wrap gap-2 mb-10"
        role="tablist"
        aria-label="Filter products by category"
        id="category-filter"
      >
        <button type="button" class="px-4 py-2 rounded-full text-sm font-medium bg-ink-900 text-paper" data-filter="all">
          All ({products.length})
        </button>
        {Object.entries(categories).map(([key, label]) => {
          const count = products.filter((p) => p.data.category === key).length;
          return count > 0 ? (
            <button type="button" class="px-4 py-2 rounded-full text-sm font-medium bg-ink-100 text-ink-900 hover:bg-ink-200 transition-colors" data-filter={key}>
              {label} ({count})
            </button>
          ) : null;
        })}
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6" id="product-grid">
        {products.map((product) => (
          <div data-category={product.data.category}>
            <ProductCard
              href={`/products/${product.id}/`}
              name={product.data.name}
              tagline={product.data.tagline}
              heroImage={product.data.heroImage}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <p class="text-center text-ink-400 mb-8">Also fabricating precision components for capacitor manufacturers</p>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 mb-8">
        {parts.map((part) => (
          <a href={`/capacitor-parts/${part.id}/`} class="capacitor-part-card card group flex flex-col items-center text-center overflow-hidden">
            <div class="aspect-square w-full p-4 flex items-center justify-center">
              <Image
                src={img(part.data.heroImage)}
                alt={part.data.name}
                width={160}
                height={160}
                class="max-w-full max-h-full object-contain transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <p class="px-3 pb-4 flex items-center justify-center gap-1.5 text-xs font-medium text-ink-900 leading-snug">
              {part.data.name}
              <ArrowRight class="size-3.5 shrink-0 text-ink-200 transition-all group-hover:text-amber-500 group-hover:translate-x-0.5" />
            </p>
          </a>
        ))}
      </div>
      <div class="text-center">
        <a href="/capacitor-parts/" class="btn btn-outline">View All Capacitor Parts</a>
      </div>
    </div>
  </section>

  <CTABand showCall={false} />
</BaseLayout>

<style>
  .capacitor-part-card {
    border-color: transparent;
    box-shadow: 0 1px 4px rgba(14, 17, 22, 0.08);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('#category-filter [data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('#product-grid [data-category]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;
      buttons.forEach((b) => b.classList.remove('bg-ink-900', 'text-paper'));
      buttons.forEach((b) => b.classList.add('bg-ink-100', 'text-ink-900'));
      btn.classList.remove('bg-ink-100');
      btn.classList.add('bg-ink-900', 'text-paper');

      cards.forEach((card) => {
        const show = filter === 'all' || card.dataset.category === filter;
        card.style.display = show ? '' : 'none';
      });
    });
  });
</script>
