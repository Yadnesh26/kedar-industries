---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ArrowRight } from '@lucide/astro';
---

<BaseLayout
  title="Page Not Found | Kedar Industries"
  description="The page you're looking for doesn't exist."
  path="/404/"
  noOrgSchema
>
  <section class="section-y">
    <div class="container-page text-center max-w-lg mx-auto">
      <p class="eyebrow mb-4">404</p>
      <h1 class="text-3xl sm:text-4xl text-ink-900 mb-4">Page not found</h1>
      <p class="text-ink-400 mb-8">
        The page you're looking for may have moved. Try the products catalogue or get in touch
        directly.
      </p>
      <div class="flex flex-wrap gap-4 justify-center">
        <a href="/" class="btn btn-primary">Back to Home <ArrowRight class="size-4" /></a>
        <a href="/products/" class="btn btn-outline">View Products</a>
      </div>
    </div>
  </section>
</BaseLayout>
