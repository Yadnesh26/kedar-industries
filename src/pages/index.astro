---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatBand from '@/components/StatBand.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductCarousel from '@/components/ProductCarousel.astro';
import ImageSlideshow from '@/components/ImageSlideshow.astro';
import PartnerCard from '@/components/PartnerCard.astro';
import LogoWall from '@/components/LogoWall.astro';
import { Image, Picture, getImage } from 'astro:assets';
import { ArrowRight, CircleCheck, Wrench, Flame, Warehouse } from '@lucide/astro';
import { img } from '@/lib/images';
import { certHref } from '@/lib/certs';
import { getCollection } from 'astro:content';

import company from '@/data/company.json';
import certifications from '@/data/certifications.json';
import cpriTests from '@/data/cpri-tests.json';
import clients from '@/data/clients.json';
import projects from '@/data/projects.json';

const allProducts = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const heroBg = img('hero-mcc-panel-factory-v5.jpg');
const heroBgPortrait = img('hero-mcc-panel-factory-portrait.jpg');

// Art direction: phones and iPad in portrait get a taller photo framed for a
// narrow screen; desktop and iPad landscape (1024px+) keep the wide one.
// Astro's <Picture> has no per-media sources, so build the srcsets here.
const heroPortraitMedia = '(max-width: 1023px) and (orientation: portrait)';
const heroWidths = [480, 768, 1024, 1440, 1920, 2560];
const heroPortraitWidths = [480, 768, 1080, 1600];
const [heroPortraitAvif, heroPortraitWebp, heroAvif, heroWebp, heroJpg] = await Promise.all([
  getImage({ src: heroBgPortrait, widths: heroPortraitWidths, format: 'avif' }),
  getImage({ src: heroBgPortrait, widths: heroPortraitWidths, format: 'webp' }),
  getImage({ src: heroBg, widths: heroWidths, format: 'avif' }),
  getImage({ src: heroBg, widths: heroWidths, format: 'webp' }),
  getImage({ src: heroBg, widths: heroWidths, format: 'jpg' }),
]);

const certTagClass =
  'flex items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.06] backdrop-blur-sm px-2.5 py-1 sm:px-3.5 sm:py-1.5 text-xs sm:text-sm font-mono-figure text-ink-100 transition duration-150 ease-out hover:border-amber-500/60 hover:bg-white/[0.1] active:scale-[0.96] active:bg-amber-500/15 focus-visible:outline-2 focus-visible:outline-amber-500';

const heroPhrases =['to standard.', 'by CPRI.', 'at 70 kA.', 'in the field.'];

const stats = [
  { value: '2019', label: 'Production commenced' },
  { value: '8,000+', numericValue: 8000, suffix: '+', label: 'Sq. ft. manufacturing facility' },
  { value: '44+', numericValue: 44, suffix: '+', label: 'Projects executed' },
  { value: '70 kA', numericValue: 70, suffix: ' kA', label: 'CPRI short-circuit withstand' },
];

const processSteps = [
  { name: 'CNC Punching', text: 'Sheet metal is punched to exact size and shape straight from the drawing' },
  { name: 'CNC Bending', text: 'Punched sheets are formed to accurate angles on a CNC press brake' },
  { name: 'Welding', text: 'Frames and enclosures are welded into rigid, square structures' },
  { name: 'Powder Coating', text: 'Parts are treated and powder coated for a durable, even finish' },
  { name: 'Busbar Fabrication', text: 'Copper and aluminium busbars are cut and bent to size' },
];

const processSlides = [
  { src: 'process-cnc-punching.jpg', label: 'CNC Punching', alt: 'CNC turret punching machine cutting a sheet-metal panel' },
  { src: 'process-cnc-bending.jpg', label: 'CNC Bending', alt: 'Operators bending sheet metal on a CNC press brake' },
  { src: 'process-welding.jpg', label: 'Welding', alt: 'Welders fabricating panel frames in the welding bay' },
  { src: 'process-powder-coating.jpg', label: 'Powder Coating', alt: 'Powder coating spray booth and treatment line' },
  { src: 'process-busbar-fabrication.jpg', label: 'Busbar Fabrication', alt: 'Busbar cutting and bending station with copper bars' },
  { src: 'process-busbar-material-racks.jpg', label: 'Busbar Material Store', alt: 'Racks of copper and aluminium busbar stock beside the busbar machine' },
];

const infrastructureFeatures = [
  { Icon: Wrench, text: 'Dedicated fabrication & panel assembly sections' },
  { Icon: Flame, text: 'In-house precision soldering & silver brazing' },
  { Icon: Warehouse, text: '8,000 sq ft shed, 25 ft clear height, single roof' },
];
---

<BaseLayout
  title="Kedar Industries"
  description="Kedar Industries in Nashik, Maharashtra makes CPRI type-tested electrical control panels (PCC, MCC, APFC and RTPFC) and also does capacitor part fabrication and precision soldering and brazing. Panels are built to IEC 61439, and the company is certified to ISO 9001, ISO 14001, ISO 45001 and IATF 16949."
  path="/"
>
  <!-- 1. Hero (extended — carries the stat row at its own bottom edge) -->
  <section class="relative bg-ink-900 overflow-hidden">
    <div class="absolute inset-0">
      <picture>
        <source media={heroPortraitMedia} type="image/avif" srcset={heroPortraitAvif.srcSet.attribute} sizes="100vw" />
        <source media={heroPortraitMedia} type="image/webp" srcset={heroPortraitWebp.srcSet.attribute} sizes="100vw" />
        <source type="image/avif" srcset={heroAvif.srcSet.attribute} sizes="100vw" />
        <source type="image/webp" srcset={heroWebp.srcSet.attribute} sizes="100vw" />
        <img
          src={heroJpg.src}
          srcset={heroJpg.srcSet.attribute}
          sizes="100vw"
          alt=""
          width={heroBg.width}
          height={heroBg.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
          class="w-full h-full object-cover object-[72%_center] max-lg:portrait:object-center lg:object-left"
        />
      </picture>
      <div class="absolute inset-0 hidden lg:block bg-gradient-to-r from-ink-900/75 via-ink-900/55 via-32% to-ink-900/20 to-46%"></div>
      {/* Below lg the text spans the full width, over the bright panel, so the
          whole photo gets an even dark wash instead of the left-only fade. */}
      <div class="absolute inset-0 bg-ink-900/65 lg:hidden"></div>
      {/* A second, bottom-anchored fade — independent of the left-right one
          above — so the stat row (full-width, lower on the image) reads
          clearly no matter how bright that part of the photo is. */}
      <div class="absolute inset-0 bg-gradient-to-t from-ink-900/85 via-transparent via-35% to-transparent"></div>
    </div>
    <div class="container-page relative flex flex-col justify-center sm:justify-start min-h-[calc(100svh-5rem-1px)] sm:min-h-[720px] lg:min-h-[800px] py-6 sm:pt-19 sm:pb-7">
      <div>
        <p class="eyebrow mb-3 sm:mb-5">Nashik, Maharashtra &middot; Est. 2019</p>
        <h1 class="text-paper text-[clamp(1.5rem,7vw,2.25rem)] sm:text-5xl md:text-6xl leading-[1.1] sm:leading-[1.05] max-w-3xl">
          Engineered to perform.<br /> Proven{' '}<span class="sr-only">to standard.</span><span class="hero-rotator" aria-hidden="true">
            {heroPhrases.map((phrase, i) => (
              <span class:list={['hero-rotator__word', i === 0 && 'is-active']}>{phrase}</span>
            ))}
          </span>
        </h1>
        <p class="mt-4 sm:mt-6 text-[0.9375rem] sm:text-xl text-ink-200 max-w-xl leading-relaxed">
          Kedar Industries manufactures electrical control panels, capacitor part fabrication, and
          precision soldering &amp; brazing, engineered to IEC 61439 and independently validated
          by CPRI.
        </p>
        <div class="mt-6 sm:mt-9 flex flex-row sm:flex-wrap gap-3 sm:gap-4">
          <a href="/products/" class="btn btn-primary justify-center flex-1 sm:flex-none px-3 sm:px-6 text-sm sm:text-[0.9375rem]">
            Explore Products <ArrowRight class="size-4" />
          </a>
          <a href="/contact/" class="btn btn-outline-dark justify-center flex-1 sm:flex-none px-3 sm:px-6 text-sm sm:text-[0.9375rem]">Request a Quote</a>
        </div>

        {/* Certifications, as individual badges rather than a single strip
            — each one its own chip so they read as distinct credentials.
            Split into two explicit rows (4 + 3) instead of one flex-wrap
            line, so on wide screens it doesn't stretch out across the
            machine in the photo. */}
        <div class="mt-6 sm:mt-10 flex flex-wrap sm:flex-col gap-2 sm:gap-2.5 max-sm:[@media(max-height:600px)]:hidden">
          <div class="contents sm:flex sm:flex-wrap sm:gap-2.5">
            {certifications.certStrip.slice(0, 4).map((cert) => (
              <a href={certHref(cert)} class={certTagClass}>
                <CircleCheck class="size-3.5 text-amber-500 shrink-0" /> {cert}
              </a>
            ))}
          </div>
          <div class="contents sm:flex sm:flex-wrap sm:gap-2.5">
            {certifications.certStrip.slice(4).map((cert) => (
              <a href={certHref(cert)} class={certTagClass}>
                <CircleCheck class="size-3.5 text-amber-500 shrink-0" /> {cert}
              </a>
            ))}
          </div>
        </div>
      </div>

      {/* 2. Stat row — plain figures overlaid on the hero photo itself,
          no card or panel of its own; the bottom fade above is what
          keeps it legible. */}
      <div class="hidden sm:block mt-auto pt-20">
        <StatBand stats={stats} />
      </div>
    </div>
  </section>

  <!-- 2. About -->
  <section class="pt-9 pb-11 sm:pt-11 sm:pb-15">
    <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal order-2 lg:order-1">
        {/* Self-hosted 24s "Amber Line" brand loop (source project lives
            outside the site in ../videos/about-amber-line). Its last frame
            matches its first, so a plain `loop` attribute is seamless — no
            third-party chrome, no JS timer. The poster is frame 0. */}
        <div class="rounded-2xl overflow-hidden border border-ink-100 shadow-sm aspect-[4/3]">
          <video
            class="w-full h-full object-cover"
            poster="/videos/about-poster.jpg"
            autoplay
            muted
            loop
            playsinline
            disablepictureinpicture
            aria-hidden="true"
          >
            <source src="/videos/about-placeholder.mp4" type="video/mp4" />
            <source src="/videos/about-placeholder.webm" type="video/webm" />
          </video>
        </div>
      </div>
      <div class="reveal order-1 lg:order-2">
        <SectionHeading eyebrow="About Kedar Industries" title={company.tagline} class="max-sm:!mb-6 max-sm:[&_h2]:text-[1.625rem]" />
        <div class="flex flex-col gap-3 sm:gap-4 mb-6 sm:mb-8 text-ink-400 leading-relaxed max-w-xl">
          <p>
            Kedar Industries manufactures electrical control panels, and also fabricates capacitor
            parts and carries out precision soldering and brazing for industrial customers.
          </p>
          <p>
            Our Nashik facility combines modern machinery, skilled technicians and in-house quality
            control, so every product is built to national and international standards.
          </p>
        </div>
        <ul class="grid sm:grid-cols-2 gap-2.5 sm:gap-3 mb-6 sm:mb-8">
          {['Design, fabricate & test in-house', 'IEC 61439 & CPRI validated', 'Vishay & C&S authorised partner', 'ISO 9001/14001/45001 + IATF 16949'].map((item) => (
            <li class="flex items-start gap-2 text-sm text-ink-600">
              <CircleCheck class="size-4 text-amber-600 shrink-0 mt-0.5" /> {item}
            </li>
          ))}
        </ul>
        <a href="/about/" class="btn btn-primary">
          Discover Our Story <ArrowRight class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- 3. Technology partners -->
  <section class="pt-7 pb-7 sm:pt-13 sm:pb-13 lg:pt-19 lg:pb-19 section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <div class="lg:flex lg:items-center lg:justify-between lg:gap-12">
        <SectionHeading
          eyebrow="Industry-certified partnerships"
          title="Authorised Technology Partners"
          lead="Kedar Industries holds authorised partner status with two established electrical brands. It is a design-and-manufacture licence, which goes beyond a reseller arrangement."
          dark
          class="max-sm:!mb-6 max-sm:[&_h2]:text-[1.625rem]"
        />
        <div class="hidden lg:flex flex-col gap-3.5 shrink-0 max-w-xs pb-12">
          {[
            'Design-and-manufacture licence',
            'Technical support',
            'Audited and renewed partnership',
          ].map((text) => (
            <div class="flex items-start gap-2.5">
              <CircleCheck class="size-4 text-amber-500 shrink-0 mt-0.5" />
              <p class="text-sm text-ink-200 leading-snug">{text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="grid lg:grid-cols-2 gap-4 sm:gap-6">
        {certifications.partnerships.map((p) => (
          <PartnerCard partner={p.partner} role={p.role} scope={p.scope} validTill={p.validTill} logo={p.logo} accentColor={p.accentColor} logoOffsetY={p.logoOffsetY} compact />
        ))}
      </div>
    </div>
  </section>

  <!-- 4. Products -->
  <section class="pt-7 pb-7 sm:pt-13 sm:pb-13 lg:pt-19 lg:pb-19 bg-ink-100/50">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-4 sm:gap-6 mb-6 sm:mb-12">
        <SectionHeading
          eyebrow="Engineered for safety, efficiency & performance"
          title="Our Electrical Panel Solutions"
          class="!mb-0 max-sm:[&_h2]:text-[1.625rem]"
        />
        <a href="/products/" class="btn btn-primary shrink-0">
          View All Products <ArrowRight class="size-4" />
        </a>
      </div>
      <ProductCarousel>
        {allProducts.map((product) => (
          <div class="w-[85vw] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4.5rem)/4)] shrink-0">
            <ProductCard
              href={`/products/${product.id}/`}
              name={product.data.name}
              tagline={product.data.tagline}
              heroImage={product.data.heroImage}
            />
          </div>
        ))}
      </ProductCarousel>
    </div>
  </section>

  <!-- 4b. Manufacturing process -->
  <section class="pt-7 pb-7 sm:pt-13 sm:pb-13 lg:pt-19 lg:pb-19 section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative grid lg:grid-cols-2 gap-6 sm:gap-12 items-stretch">
      <div class="reveal">
        <SectionHeading
          eyebrow="Manufacturing process"
          title="From sheet metal to finished panel"
          lead="Every enclosure is cut, formed, welded and finished in-house, so each stage stays under our own quality control."
          dark
          class="max-sm:!mb-6 max-sm:[&_h2]:text-[1.625rem]"
        />
        <ol class="flex flex-col gap-2.5 sm:gap-3">
          {processSteps.map((step, i) => (
            <li class="flex items-baseline gap-4 rounded-md border border-white/10 bg-white/5 px-4 py-3 sm:py-3.5">
              <span class="font-mono-figure text-sm font-semibold text-amber-500 w-6 shrink-0">{String(i + 1).padStart(2, '0')}</span>
              <p class="text-sm 2xl:text-base text-ink-200 leading-relaxed"><strong class="font-display font-bold text-paper text-base 2xl:text-[1.0625rem]">{step.name}:</strong> {step.text}</p>
            </li>
          ))}
        </ol>
      </div>
      <div class="reveal lg:h-full">
        <ImageSlideshow label="Kedar Industries manufacturing process" slides={processSlides} interval={3000} bordered={false} fill />
      </div>
    </div>
  </section>

  <!-- 5. Infrastructure -->
  <section class="pt-[2.55rem] pb-[2.55rem] sm:pt-[3.825rem] sm:pb-[3.825rem] lg:pt-[5.1rem] lg:pb-[5.1rem]">
    <div class="container-page grid lg:grid-cols-2 gap-6 sm:gap-[2.55rem] items-center">
      <div class="grid grid-cols-[1.4fr_1fr] grid-rows-3 gap-2 rounded-2xl overflow-hidden aspect-[1.5686]">
        <div class="row-span-3">
          <Image
            src={img('facility-panel-assembly-testing-area.jpg')}
            alt="Panel assembly and testing area at Kedar Industries' Nashik facility"
            width={900}
            height={1160}
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <Image
            src={img('facility-production-floor-team-01.jpg')}
            alt="Production team at work on the Kedar Industries shop floor"
            width={640}
            height={360}
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <Image
            src={img('facility-production-floor-team-02.jpg')}
            alt="Assembly workstations on the Kedar Industries production floor"
            width={640}
            height={360}
            class="w-full h-full object-cover"
          />
        </div>
        <div>
          <Image
            src={img('facility-raw-material-store-area.jpg')}
            alt="Organised raw-material store area at Kedar Industries"
            width={640}
            height={360}
            class="w-full h-full object-cover"
          />
        </div>
      </div>
      <div>
        <SectionHeading
          eyebrow="Manufacturing facility"
          title="8,000 sq ft. Every stage in-house."
          lead="Every panel begins with the right foundation: a facility designed to handle complex requirements with speed, accuracy and zero compromise on quality."
          class="max-sm:!mb-6 max-sm:[&_h2]:text-[1.625rem]"
        />
        <ul class="flex flex-col gap-2 sm:gap-3 mb-6 sm:mb-[1.7rem]">
          {infrastructureFeatures.map((f) => (
            <li class="flex items-center gap-3 text-sm text-ink-900 bg-ink-100/60 rounded-md px-4 py-2.5 sm:py-3">
              <f.Icon class="size-4 text-amber-600 shrink-0" /> {f.text}
            </li>
          ))}
        </ul>
        <a href="/about/infrastructure/" class="btn btn-primary">
          Inside Our Factory <ArrowRight class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- 6. Quality Assurance (incl. CPRI headline figures) -->
  <section class="pt-7 pb-7 sm:pt-13 sm:pb-13 lg:pt-19 lg:pb-19 section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative grid lg:grid-cols-2 gap-6 sm:gap-12 items-center">
      <div>
        <SectionHeading
          eyebrow="Quality assurance"
          title="Every panel tested. Every standard met."
          lead="We manufacture panels and stand behind their performance. From raw material inspection to final dispatch, independently verified by CPRI per IEC 61439-1 & 2."
          dark
          class="max-sm:!mb-6 max-sm:[&_h2]:text-[1.625rem]"
        />
        <div class="grid grid-cols-3 gap-2 sm:gap-3 mb-6 sm:mb-8">
          <div class="rounded-md bg-white/5 border border-white/10 p-4 text-center">
            <p class="font-mono-figure text-xl text-amber-500 font-semibold">70 kA</p>
            <p class="text-xs text-ink-200 mt-1">Short-circuit withstand</p>
          </div>
          <div class="rounded-md bg-white/5 border border-white/10 p-4 text-center">
            <p class="font-mono-figure text-xl text-amber-500 font-semibold">{cpriTests.temperatureRise.maxRiseK} K</p>
            <p class="text-xs text-ink-200 mt-1">Max. temperature rise</p>
          </div>
          <div class="rounded-md bg-white/5 border border-white/10 p-4 text-center">
            <p class="font-mono-figure text-xl text-amber-500 font-semibold">IP55</p>
            <p class="text-xs text-ink-200 mt-1">Enclosure protection</p>
          </div>
        </div>
        <a href="/about/quality/" class="btn btn-primary">
          Quality &amp; Certification <ArrowRight class="size-4" />
        </a>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-sm">
        <Image
          src={img('home-qa-panel-testing.jpg')}
          alt="Technician testing panel wiring with a multimeter against a QA checklist"
          width={1184}
          height={740}
          fit="cover"
          class="w-full object-cover aspect-[16/10]"
        />
      </div>
    </div>
  </section>

  <!-- 7. Clients -->
  <section class="pt-7 pb-7 sm:pt-13 sm:pb-13 lg:pt-19 lg:pb-19 section-diagonal-light">
    <div class="section-diagonal-light__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="Our clients"
        title="Trusted Relationships"
        lead={`Registered vendor of ${clients.registeredVendorOf.length} major industrial groups, with ${projects.length}+ projects delivered.`}
          class="max-sm:!mb-6 max-sm:[&_h2]:text-[1.625rem]"
        />
      <LogoWall logos={clients.logos} />
    </div>
  </section>
</BaseLayout>

<script>
  const words = document.querySelectorAll<HTMLElement>('.hero-rotator__word');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (words.length > 1 && !reduceMotion) {
    let current = 0;
    setInterval(() => {
      const prev = words[current];
      current = (current + 1) % words.length;
      prev.classList.remove('is-active');
      prev.classList.add('is-leaving');
      words[current].classList.add('is-active');
      setTimeout(() => prev.classList.remove('is-leaving'), 600);
    }, 2800);
  }
</script>

<style>
  /* All phrases share one grid cell, so the rotator is always as wide as the
     longest phrase — the fixed part of the headline never shifts. */
  .hero-rotator {
    display: inline-grid;
    vertical-align: baseline;
    white-space: nowrap;
    overflow: hidden;
    /* Room for descenders (the "y" in "by") inside the clip, cancelled out
       so the line height matches the static headline. */
    padding-bottom: 0.12em;
    margin-bottom: -0.12em;
  }
  .hero-rotator__word {
    grid-area: 1 / 1;
    color: var(--color-amber-500);
    opacity: 0;
    transform: translateY(0.6em);
    filter: blur(6px);
    transition:
      opacity 550ms var(--ease-out-standard),
      transform 550ms var(--ease-out-standard),
      filter 550ms var(--ease-out-standard);
  }
  .hero-rotator__word.is-active {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }
  .hero-rotator__word.is-leaving {
    opacity: 0;
    transform: translateY(-0.6em);
    filter: blur(6px);
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-rotator__word {
      transition: none;
    }
  }
</style>
