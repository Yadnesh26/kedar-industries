---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import StatBand from '@/components/StatBand.astro';
import ProductCard from '@/components/ProductCard.astro';
import ProductCarousel from '@/components/ProductCarousel.astro';
import PartnerCard from '@/components/PartnerCard.astro';
import LogoWall from '@/components/LogoWall.astro';
import { Image, Picture } from 'astro:assets';
import { ArrowRight, CircleCheck, Wrench, Flame, Warehouse } from '@lucide/astro';
import { img } from '@/lib/images';
import { getCollection } from 'astro:content';

import company from '@/data/company.json';
import certifications from '@/data/certifications.json';
import cpriTests from '@/data/cpri-tests.json';
import clients from '@/data/clients.json';
import projects from '@/data/projects.json';

const allProducts = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);

const heroBg = img('panel-apfc-batch-ready-for-dispatch-3.jpg');

const stats = [
  { value: '2019', label: 'Production commenced' },
  { value: '8,000+', numericValue: 8000, suffix: '+', label: 'Sq. ft. manufacturing facility' },
  { value: '44+', numericValue: 44, suffix: '+', label: 'Projects executed' },
  { value: '70 kA', numericValue: 70, suffix: ' kA', label: 'CPRI short-circuit withstand' },
];

const infrastructureFeatures = [
  { Icon: Wrench, text: 'Dedicated fabrication & panel assembly sections' },
  { Icon: Flame, text: 'In-house precision soldering & silver brazing' },
  { Icon: Warehouse, text: '8,000 sq ft shed, 25 ft clear height, single roof' },
];
---

<BaseLayout
  title="Kedar Industries | CPRI Type-Tested Electrical Control Panel Manufacturer, Nashik"
  description="Kedar Industries manufactures CPRI type-tested electrical control panels — PCC, MCC, APFC, RTPFC — plus capacitor part fabrication and precision soldering & brazing. IEC 61439, ISO 9001/14001/45001, IATF 16949 certified. Nashik, Maharashtra."
  path="/"
>
  <!-- 1. Hero -->
  <section class="relative bg-ink-900 overflow-hidden">
    <div class="absolute inset-0">
      <Picture
        src={heroBg}
        alt=""
        widths={[480, 768, 1024, 1440, 1920, 2560]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
        class="w-full h-full object-cover object-[center_30%] sm:object-center opacity-55 scale-[1.9] sm:scale-[1.5] translate-x-[50px] -translate-y-[50px]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-ink-900 via-ink-900/85 to-ink-900/30"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-transparent to-transparent"></div>
    </div>
    <div class="container-page relative pt-20 pb-24 sm:pt-24 sm:pb-28">
      <p class="eyebrow mb-5">Nashik, Maharashtra &middot; Est. 2019</p>
      <h1 class="text-paper text-4xl sm:text-5xl md:text-6xl leading-[1.05] max-w-3xl">
        Type-tested power.<br /> Built in Nashik.
      </h1>
      <p class="mt-6 text-lg sm:text-xl text-ink-200 max-w-xl leading-relaxed">
        Kedar Industries manufactures electrical control panels, capacitor part fabrication, and
        precision soldering &amp; brazing — engineered to IEC 61439 and independently validated
        by CPRI.
      </p>
      <div class="mt-9 flex flex-wrap gap-4">
        <a href="/products/" class="btn btn-primary">
          Explore Products <ArrowRight class="size-4" />
        </a>
        <a href="/contact/" class="btn btn-outline-dark">Request a Quote</a>
      </div>

      {/* Certifications, as individual badges rather than a single strip
          — each one its own chip so they read as distinct credentials. */}
      <div class="mt-10 flex flex-wrap gap-2.5">
        {certifications.certStrip.map((cert) => (
          <span class="flex items-center gap-1.5 rounded-full border border-white/15 bg-white/[0.06] backdrop-blur-sm px-3.5 py-1.5 text-xs sm:text-sm font-mono-figure text-ink-100">
            <CircleCheck class="size-3.5 text-amber-500 shrink-0" /> {cert}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- 2. Stat band (floating card overlapping the hero) -->
  <StatBand stats={stats} />

  <!-- 3. About -->
  <section class="pt-14 pb-16 sm:pt-16 sm:pb-20">
    <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
      <div class="reveal order-2 lg:order-1">
        <div class="rounded-2xl overflow-hidden border border-ink-100 shadow-sm">
          <Image
            src={img('panel-apfc-batch-ready-for-dispatch-2.jpg')}
            alt="APFC panels ready for dispatch at Kedar Industries"
            width={640}
            height={480}
            class="w-full h-full object-cover aspect-[4/3]"
          />
        </div>
      </div>
      <div class="reveal order-1 lg:order-2">
        <SectionHeading eyebrow="About Kedar Industries" title={company.tagline} />
        <p class="text-ink-400 leading-relaxed mb-6">{company.about}</p>
        <ul class="grid sm:grid-cols-2 gap-3 mb-8">
          {['Design, fabricate & test in-house', 'IEC 61439 & CPRI validated', 'Vishay & C&S authorised partner', 'ISO 9001/14001/45001 + IATF 16949'].map((item) => (
            <li class="flex items-start gap-2 text-sm text-ink-600">
              <CircleCheck class="size-4 text-amber-600 shrink-0 mt-0.5" /> {item}
            </li>
          ))}
        </ul>
        <a href="/about/" class="btn btn-primary">
          Discover Our Story <ArrowRight class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- 4. Technology partners -->
  <section class="section-y section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <div class="lg:flex lg:items-center lg:justify-between lg:gap-12">
        <SectionHeading
          eyebrow="Industry-certified partnerships"
          title="Authorised Technology Partners"
          lead="Kedar Industries holds authorised partner status with two established electrical brands — not a reseller arrangement, but a design-and-manufacture licence."
          dark
        />
        <div class="hidden lg:flex flex-col gap-3.5 shrink-0 max-w-xs pb-12">
          {[
            'Design-and-manufacture licence',
            'Technical support',
            'Audited and renewed partnership',
          ].map((text) => (
            <div class="flex items-start gap-2.5">
              <CircleCheck class="size-4 text-amber-500 shrink-0 mt-0.5" />
              <p class="text-sm text-ink-200 leading-snug">{text}</p>
            </div>
          ))}
        </div>
      </div>
      <div class="grid lg:grid-cols-2 gap-6">
        {certifications.partnerships.map((p) => (
          <PartnerCard partner={p.partner} role={p.role} scope={p.scope} validTill={p.validTill} logo={p.logo} accentColor={p.accentColor} logoOffsetY={p.logoOffsetY} />
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Products -->
  <section class="section-y">
    <div class="container-page">
      <div class="flex flex-wrap items-end justify-between gap-6 mb-12">
        <SectionHeading
          eyebrow="Engineered for safety, efficiency & performance"
          title="Our Electrical Panel Solutions"
        />
        <a href="/products/" class="btn btn-primary shrink-0">
          View All Products <ArrowRight class="size-4" />
        </a>
      </div>
      <ProductCarousel>
        {allProducts.map((product) => (
          <div class="w-[85vw] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-3rem)/3)] shrink-0">
            <ProductCard
              href={`/products/${product.id}/`}
              name={product.data.name}
              tagline={product.data.tagline}
              heroImage={product.data.heroImage}
            />
          </div>
        ))}
      </ProductCarousel>
    </div>
  </section>

  <!-- 6. Infrastructure -->
  <section class="pt-[2.55rem] pb-[2.55rem] sm:pt-[3.825rem] sm:pb-[3.825rem] lg:pt-[5.1rem] lg:pb-[5.1rem] section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="absolute inset-0 opacity-[0.04] bg-[radial-gradient(circle_at_80%_20%,#FFC629,transparent_50%)]"></div>
    <div class="container-page relative grid lg:grid-cols-2 gap-[2.55rem] items-center">
      <div class="rounded-2xl overflow-hidden">
        <Image
          src={img('panel-mcc-buckets-doors-open.png')}
          alt="Panel assembly on the Kedar Industries shop floor"
          width={640}
          height={480}
          class="w-full object-cover aspect-[1.5686]"
        />
      </div>
      <div>
        <SectionHeading
          eyebrow="Manufacturing facility"
          title="8,000 sq ft. Every stage in-house."
          lead="Every panel begins with the right foundation — a facility designed to handle complex requirements with speed, accuracy and zero compromise on quality."
          dark
        />
        <ul class="flex flex-col gap-3 mb-[1.7rem]">
          {infrastructureFeatures.map((f) => (
            <li class="flex items-center gap-3 text-sm text-ink-200 bg-white/5 rounded-md px-4 py-3">
              <f.Icon class="size-4 text-amber-500 shrink-0" /> {f.text}
            </li>
          ))}
        </ul>
        <a href="/about/infrastructure/" class="btn btn-primary">
          Inside Our Factory <ArrowRight class="size-4" />
        </a>
      </div>
    </div>
  </section>

  <!-- 7. Quality Assurance (incl. CPRI headline figures) -->
  <section class="section-y">
    <div class="container-page grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <SectionHeading
          eyebrow="Quality assurance"
          title="Every panel tested. Every standard met."
          lead="We don't just manufacture panels — we guarantee their performance. From raw material inspection to final dispatch, independently verified by CPRI per IEC 61439-1 & 2."
        />
        <div class="grid grid-cols-3 gap-3 mb-8">
          <div class="card p-4 text-center">
            <p class="font-mono-figure text-xl text-amber-600 font-semibold">70 kA</p>
            <p class="text-xs text-ink-400 mt-1">Short-circuit withstand</p>
          </div>
          <div class="card p-4 text-center">
            <p class="font-mono-figure text-xl text-amber-600 font-semibold">{cpriTests.temperatureRise.maxRiseK} K</p>
            <p class="text-xs text-ink-400 mt-1">Max. temperature rise</p>
          </div>
          <div class="card p-4 text-center">
            <p class="font-mono-figure text-xl text-amber-600 font-semibold">IP55</p>
            <p class="text-xs text-ink-400 mt-1">Enclosure protection</p>
          </div>
        </div>
        <a href="/about/quality/" class="btn btn-primary">
          Quality &amp; Certification <ArrowRight class="size-4" />
        </a>
      </div>
      <div class="rounded-2xl overflow-hidden border border-ink-100 shadow-sm">
        <Image
          src={img('panel-apfc-internal-wiring-doors-open.jpg')}
          alt="APFC panel internal wiring, doors open, undergoing inspection"
          width={640}
          height={480}
          class="w-full object-cover aspect-[4/3]"
        />
      </div>
    </div>
  </section>

  <!-- 8. Clients -->
  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading
        eyebrow="Our clients"
        title="Trusted Relationships"
        lead={`Registered vendor of ${clients.registeredVendorOf.length} major industrial groups, with ${projects.length}+ projects delivered.`}
      />
      <LogoWall logos={clients.logos} />
    </div>
  </section>
</BaseLayout>
