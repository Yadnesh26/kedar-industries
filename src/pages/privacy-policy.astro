---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import company from '@/data/company.json';

const updated = 'September 2026';
---

<BaseLayout
  title="Privacy Policy | Kedar Industries"
  description="How Kedar Industries collects, uses, and protects information submitted through this website."
  path="/privacy-policy/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Privacy Policy' }]} />
  <section class="section-y">
    <div class="container-page max-w-3xl">
      <h1 class="text-3xl text-ink-900 mb-2">Privacy Policy</h1>
      <p class="text-sm text-ink-400 mb-10">Last updated: {updated}</p>

      <div class="prose-content flex flex-col gap-6 text-ink-600 leading-relaxed">
        <p>
          Kedar Industries ("we", "us", "our") respects your privacy. This policy explains what
          information we collect through kedarindustries.net, how we use it, and how you can
          contact us about it.
        </p>

        <h2 class="text-xl font-display font-bold text-ink-900 mt-4">Information we collect</h2>
        <p>
          When you submit an enquiry through our contact form, we collect the information you
          provide: name, company name, phone number, email address, and any message or product/
          service selection. We do not collect this information through any other means, and we
          do not use tracking cookies or third-party advertising scripts on this site.
        </p>

        <h2 class="text-xl font-display font-bold text-ink-900 mt-4">How we use your information</h2>
        <p>
          Enquiry information is used solely to respond to your request — to prepare a quotation,
          answer a technical question, or arrange a call. We do not sell or rent your information
          to third parties.
        </p>

        <h2 class="text-xl font-display font-bold text-ink-900 mt-4">Data retention</h2>
        <p>
          We retain enquiry records for as long as reasonably necessary to respond to you and
          maintain our business records, consistent with applicable Indian law.
        </p>

        <h2 class="text-xl font-display font-bold text-ink-900 mt-4">Contact us</h2>
        <p>
          For any question about this policy or your information, contact us at{' '}
          <a href={`mailto:${company.emails[0]}`} class="text-amber-600 hover:underline">{company.emails[0]}</a>{' '}
          or {company.phone}.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
