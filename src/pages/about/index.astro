---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Timeline from '@/components/Timeline.astro';
import IndustryMarquee from '@/components/IndustryMarquee.astro';
import ImageSlideshow from '@/components/ImageSlideshow.astro';
import LogoWall from '@/components/LogoWall.astro';
import CTABand from '@/components/CTABand.astro';
import { Image } from 'astro:assets';
import { CircleCheck, ArrowRight, Building2, ShieldCheck, Factory, Handshake, BadgeCheck, Ruler, Headset } from '@lucide/astro';
import { img } from '@/lib/images';
import company from '@/data/company.json';
import clients from '@/data/clients.json';


const heroSlides = [
  { src: 'facility-panel-assembly-testing-area.jpg', alt: 'Panel assembly and testing area at Kedar Industries' },
  { src: 'about-slide-production-floor.jpg', alt: 'Production team at assembly workstations on the Kedar Industries shop floor' },
  { src: 'about-slide-soldering-stations.jpg', alt: 'Technicians at the precision soldering stations' },
  { src: 'about-slide-quality-inspection.jpg', alt: 'Quality inspector checking a component with calipers' },
  { src: 'about-slide-packing-wrapping.jpg', alt: 'Team wrapping and labelling packages for dispatch' },
];

const reasons = [
  { Icon: ShieldCheck, title: 'Type-tested and rated', detail: 'A 4000 A Power-cum-Motor Control Centre validated at CPRI per IEC 61439-1 & 2 - 70 kA short circuit, temperature rise and IP55.' },
  { Icon: Factory, title: 'Every stage in-house', detail: '8,000 sq ft under one roof - fabrication, panel assembly, soldering & brazing, inspection and dispatch.' },
  { Icon: Handshake, title: 'Authorised partnerships', detail: 'Vishay Partner & System Integrator for APFC and harmonic filtering; C&S Electric licensed CX Partner for TTA switchgear.' },
  { Icon: BadgeCheck, title: 'Certified management systems', detail: 'ISO 9001, ISO 14001, ISO 45001 and IATF 16949, plus MSME ZED Gold for sustainable manufacturing.' },
  { Icon: Ruler, title: 'Built to your specification', detail: 'Standard ranges or one-off builds to drawing - panels engineered around the load, the site and the standard.' },
  { Icon: Headset, title: 'Support after dispatch', detail: 'Installation and commissioning, annual maintenance contracts, genuine spares and active technical support.' },
];

const milestones = [
  { period: '2019', title: 'Production commenced', description: 'Kedar Industries began manufacturing electrical control panels and capacitor parts at Plot No. M-20, Siemens Road, MIDC Ambad, Nashik.' },
  { period: 'FY 2022–23', title: 'Vishay continuous production line', description: 'Established an ongoing capacitor-parts production line for Vishay Components India, including a 200-set export order for 690 V WECS capacitors.' },
  { period: '2023', title: 'Management-system certification', description: 'Certified to ISO 9001:2015, ISO 14001:2015, ISO 45001:2018, and IATF 16949:2016, covering audited quality, environmental, safety and automotive management systems.' },
  { period: '2025', title: 'Authorised partnerships', description: 'Appointed Vishay’s Partner & System Integrator for APFC and Passive Harmonic Filtering panels, and C&S Electric’s licensed CX Partner for TTA switchgear per IEC 61439.' },
  { period: '2026', title: 'ZED Gold certification', description: 'Achieved MSME ZED Gold, the government’s Zero Defect Zero Effect sustainable manufacturing certification.' },
  { period: '2026', title: 'CPRI type testing', description: 'A 4000 A, 415 V Power-cum-Motor Control Centre underwent full type testing at CPRI, Bhopal & Noida, per IEC 61439-1 & 2, covering short-circuit, temperature rise and IP55.' },
];
---

<BaseLayout
  title="About Us | Kedar Industries"
  description="Kedar Industries is a proprietary electrical control panel manufacturer in Nashik, Maharashtra, led by CEO Sandip Patil. The company holds ISO and IATF certification, its panels are CPRI type-tested, and it is an authorised partner of Vishay and C&S Electric."
  path="/about/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About Us' }]} />

  <section class="section-y">
    <div class="container-page grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div class="relative order-2 lg:order-1">
        <ImageSlideshow label="Kedar Industries facility photos" slides={heroSlides} interval={3000} />
      </div>
      <div class="order-1 lg:order-2">
        <h1 class="text-ink-900 text-[2rem] sm:text-5xl lg:text-[clamp(1.75rem,2.9vw,2.6rem)] leading-[1.15] mb-6">
          <span class="block sm:whitespace-nowrap">Engineered with <span class="text-amber-600">Precision.</span></span>
          <span class="block sm:whitespace-nowrap">Delivered with <span class="text-[#8a3b0b]">Integrity.</span></span>
        </h1>
        <p class="text-ink-400 leading-relaxed mb-4">
          KEDAR INDUSTRIES is a trusted manufacturer of Electrical Control Panels, specializing in
          Capacitor Part Fabrication and Precision Soldering &amp; Brazing activities. The firm
          delivers engineering solutions for a range of industrial sectors through innovation,
          precision, and customer-focused service.
        </p>
        <p class="text-ink-400 leading-relaxed">
          The manufacturing facility is equipped with advanced machinery, skilled technicians, and
          modern quality-control systems, enabling production of reliable and durable products in
          compliance with national and international standards. As a quality-focused organization,
          Kedar Industries continuously invests in technology, process improvement, and workforce
          development for superior performance, safety, and environmental responsibility.
        </p>
      </div>
    </div>
  </section>

  <section class="py-8 border-y border-ink-100 bg-ink-100/30">
    <div class="container-page">
      <LogoWall logos={clients.logos} />
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading eyebrow="Our journey" title="From first panel to CPRI-tested engineering" noWrap />
      <Timeline milestones={milestones} />
    </div>
  </section>

  <section class="section-y">
    <div class="container-page grid lg:grid-cols-[auto_minmax(0,44rem)] justify-center gap-10 lg:gap-16 items-center">
      <div class="flex flex-col items-center text-center lg:pr-16 lg:border-r lg:border-ink-200">
        <Image
          src={img('sandip-patil-ceo-2026b.jpg')}
          alt="Sandip Patil, Executive Managing Director, Kedar Industries"
          width={160}
          height={160}
          class="size-32 sm:size-36 rounded-full object-cover ring-4 ring-amber-500 ring-offset-4 ring-offset-paper"
        />
        <p class="eyebrow mt-6 mb-1.5">Leadership</p>
        <h3 class="font-display font-bold text-2xl text-ink-900">Sandip Patil</h3>
        <p class="text-sm text-ink-400 mt-1">Chief Executive Officer, Kedar Industries</p>
        <a
          href="https://www.linkedin.com/in/sandip-patil1982/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sandip Patil on LinkedIn"
          class="btn btn-primary mt-5 !px-[1.275rem] !py-[0.6375rem] !text-[0.8rem] !gap-[0.425rem]"
        >
          <svg class="size-[1.0625rem] shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          Connect
        </a>
      </div>

      <div class="text-center">
        <p class="eyebrow mb-4">Our vision</p>
        <span class="block font-display font-bold text-6xl leading-none text-amber-500 h-8" aria-hidden="true">“</span>
        <p class="font-display font-semibold text-ink-900 text-xl sm:text-2xl lg:text-[1.75rem] leading-snug max-w-3xl mx-auto">{company.vision}</p>
      </div>
    </div>
  </section>

  <section class="section-y section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="Why Kedar Industries"
        title="What you get when you buy a panel from us"
        dark
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {reasons.map((r) => (
          <div class="rounded-md bg-white/5 border border-white/10 p-6">
            <r.Icon class="size-6 text-amber-500 mb-4" />
            <h3 class="font-display font-bold text-paper text-base mb-2">{r.title}</h3>
            <p class="text-sm text-ink-200 leading-relaxed">{r.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <SectionHeading eyebrow="Sectors served" title="Trusted across industrial sectors" noWrap />
      <IndustryMarquee industries={clients.industries} />
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading
        eyebrow="Who we work with"
        title="Clients & Associations"
        lead={`Registered vendor of ${clients.registeredVendorOf.length} major industrial groups.`}
      />
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <h3 class="font-display font-bold text-ink-900 text-lg mb-4 flex items-center gap-2">
            <Building2 class="size-5 text-amber-600" /> Registered Vendor Of
          </h3>
          <ul class="flex flex-col gap-2.5">
            {clients.registeredVendorOf.map((c) => (
              <li class="text-sm text-ink-900 py-2.5 px-4 rounded-md bg-paper border border-ink-100">{c}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-display font-bold text-ink-900 text-lg mb-4">Associated Consultants</h3>
          <ul class="flex flex-col gap-2.5">
            {clients.associatedConsultants.map((c) => (
              <li class="text-sm text-ink-900 py-2.5 px-4 rounded-md bg-paper border border-ink-100">{c}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page text-center">
      <a href="/about/quality/" class="inline-flex items-center gap-1.5 text-amber-600 font-semibold text-sm hover:gap-2.5 transition-all">
        See the CPRI type-test reports & certifications <ArrowRight class="size-4" />
      </a>
    </div>
  </section>

  <CTABand
    title="Want the full picture?"
    lead="See the CPRI type-test reports and every certification behind these numbers."
    showCall={false}
  />
</BaseLayout>
