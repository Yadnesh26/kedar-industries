---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Timeline from '@/components/Timeline.astro';
import IndustryChip from '@/components/IndustryChip.astro';
import LogoWall from '@/components/LogoWall.astro';
import CTABand from '@/components/CTABand.astro';
import { Image } from 'astro:assets';
import { CircleCheck, ArrowRight, Building2, ShieldCheck, Factory, Handshake, BadgeCheck, Ruler, Headset } from '@lucide/astro';
import { img } from '@/lib/images';
import company from '@/data/company.json';
import clients from '@/data/clients.json';
import projects from '@/data/projects.json';

const featuredProjects = projects.filter((p) => p.featured);

const coreValues = [
  { name: 'Quality', detail: 'Inspected at incoming, in-process and final stage, with documentation and traceability.' },
  { name: 'Innovation', detail: 'Continuous investment in technology and manufacturing process improvement.' },
  { name: 'Excellence', detail: 'Highest standards of safety, environmental responsibility and operational discipline.' },
];

const reasons = [
  { Icon: ShieldCheck, title: 'Type-tested and rated', detail: 'A 4000 A Power-cum-Motor Control Centre validated at CPRI per IEC 61439-1 & 2 - 70 kA short circuit, temperature rise and IP55.' },
  { Icon: Factory, title: 'Every stage in-house', detail: '8,000 sq ft under one roof - fabrication, panel assembly, soldering & brazing, inspection and dispatch.' },
  { Icon: Handshake, title: 'Authorised partnerships', detail: 'Vishay Partner & System Integrator for APFC and harmonic filtering; C&S Electric licensed CX Partner for TTA switchgear.' },
  { Icon: BadgeCheck, title: 'Certified management systems', detail: 'ISO 9001, ISO 14001, ISO 45001 and IATF 16949, plus MSME ZED Silver for sustainable manufacturing.' },
  { Icon: Ruler, title: 'Built to your specification', detail: 'Standard ranges or one-off builds to drawing - panels engineered around the load, the site and the standard.' },
  { Icon: Headset, title: 'Support after dispatch', detail: 'Installation and commissioning, annual maintenance contracts, genuine spares and active technical support.' },
];

const milestones = [
  { period: '2019', title: 'Production commenced', description: 'Kedar Industries began manufacturing electrical control panels and capacitor parts at Plot No. M-20, Siemens Road, MIDC Ambad, Nashik.' },
  { period: 'FY 2022–23', title: 'Vishay continuous production line', description: 'Established an ongoing capacitor-parts production line for Vishay Components India, including a 200-set export order for 690 V WECS capacitors.' },
  { period: '2023', title: 'Management-system certification', description: 'Certified to ISO 9001:2015, ISO 14001:2015, ISO 45001:2018, and IATF 16949:2016 — audited quality, environmental, safety and automotive management systems.' },
  { period: '2025', title: 'Authorised partnerships', description: 'Appointed Vishay’s Partner & System Integrator for APFC and Passive Harmonic Filtering panels, and C&S Electric’s licensed CX Partner for TTA switchgear per IEC 61439.' },
  { period: '2025', title: 'ZED Silver certification', description: 'Achieved MSME ZED Silver — the government’s Zero Defect Zero Effect sustainable manufacturing certification.' },
  { period: '2026', title: 'CPRI type testing', description: 'A 4000 A, 415 V Power-cum-Motor Control Centre underwent full type testing at CPRI, Bhopal & Noida, per IEC 61439-1 & 2 — short-circuit, temperature rise and IP55.' },
];
---

<BaseLayout
  title="About Us | Kedar Industries"
  description="Kedar Industries is a proprietary electrical control panel manufacturer in Nashik, Maharashtra, led by CEO Sandip Patil. ISO/IATF certified, CPRI type-tested, and an authorised Vishay & C&S Electric partner."
  path="/about/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About Us' }]} />

  <section class="section-y">
    <div class="container-page grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div class="relative order-2 lg:order-1">
        <Image
          src={img('panel-apfc-batch-ready-for-dispatch-21.jpg')}
          alt="Batch of APFC panels ready for dispatch inside Kedar Industries' Nashik facility"
          width={900}
          height={675}
          class="rounded-lg object-cover w-full aspect-[1.5686] shadow-xl border-4 border-paper ring-1 ring-ink-100"
        />
      </div>
      <div class="order-1 lg:order-2">
        <p class="eyebrow mb-4">Built on proof</p>
        <h1 class="text-ink-900 text-4xl sm:text-5xl leading-[1.1] mb-6">
          Built on proof. Driven by engineering.
        </h1>
        <p class="text-ink-400 leading-relaxed">{company.about}</p>
      </div>
    </div>
  </section>

  <section class="py-8 border-y border-ink-100 bg-ink-100/30">
    <div class="container-page">
      <LogoWall logos={clients.logos} />
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading eyebrow="Our journey" title="From first panel to CPRI-tested engineering" noWrap />
      <Timeline milestones={milestones} />
    </div>
  </section>

  <section>
    <Image
      src={img('team-kedar-industries-group-photo.jpg')}
      alt="The Kedar Industries team outside the Plot No. M-20 works at MIDC Ambad, Nashik"
      width={2383}
      height={945}
      class="w-full object-cover object-top h-64 sm:h-80 lg:h-[30rem]"
    />
    <p class="container-page py-3 text-xs text-ink-400 border-b border-ink-100">
      The Kedar Industries team outside the works at Plot No. M-20, MIDC Ambad, Nashik.
    </p>
  </section>

  <section class="section-y bg-ink-900 relative overflow-hidden">
   
    <div class="container-page relative flex flex-col sm:flex-row items-center gap-8 text-center sm:text-left">
      <Image
        src={img('sandip-patil-ceo.jpg')}
        alt="Sandip Patil, Executive Managing Director, Kedar Industries"
        width={160}
        height={160}
        class="shrink-0 size-32 sm:size-40 rounded-full object-cover ring-4 ring-amber-500 ring-offset-4 ring-offset-ink-900"
      />
      <div>
        <p class="eyebrow mb-2">Leadership</p>
        <h3 class="font-display font-bold text-2xl sm:text-3xl text-paper">Sandip Patil</h3>
        <p class="text-ink-200 mt-1.5">Chief Executive Officer, Kedar Industries</p>
        <a
          href="https://www.linkedin.com/in/sandip-patil1982/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Sandip Patil on LinkedIn"
          class="inline-flex items-center gap-2 mt-4 pl-2.5 pr-4 py-2 rounded-full bg-amber-500 text-ink-900 text-sm font-semibold shadow-md transition-all duration-200 hover:bg-amber-600 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-amber-500/40"
        >
          <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
          </svg>
          Connect 
        </a>
      </div>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page grid md:grid-cols-3 gap-8">
      <div class="card border-t-2 border-t-amber-500 p-8">
        <h3 class="font-display font-bold text-xl text-ink-900 mb-3">Vision</h3>
        <p class="text-sm text-ink-400 leading-relaxed">{company.vision}</p>
      </div>
      <div class="card border-t-2 border-t-amber-500 p-8">
        <h3 class="font-display font-bold text-xl text-ink-900 mb-3">Mission</h3>
        <ul class="flex flex-col gap-2.5">
          {company.mission.map((m) => (
            <li class="flex items-start gap-2 text-sm text-ink-400">
              <CircleCheck class="size-4 text-amber-600 shrink-0 mt-0.5" /> {m}
            </li>
          ))}
        </ul>
      </div>
      <div class="card border-t-2 border-t-amber-500 p-8">
        <h3 class="font-display font-bold text-xl text-ink-900 mb-3">Core Values</h3>
        <p class="text-sm text-ink-400 leading-relaxed mb-4">{company.tagline}</p>
        <ul class="flex flex-col gap-3">
          {coreValues.map((v) => (
            <li>
              <p class="text-sm font-semibold text-ink-900">{v.name}</p>
              <p class="text-sm text-ink-400 leading-relaxed">{v.detail}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section-y section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="Why Kedar Industries"
        title="What you get when you buy a panel from us"
        dark
      />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {reasons.map((r) => (
          <div class="rounded-md bg-white/5 border border-white/10 p-6">
            <r.Icon class="size-6 text-amber-500 mb-4" />
            <h3 class="font-display font-bold text-paper text-base mb-2">{r.title}</h3>
            <p class="text-sm text-ink-200 leading-relaxed">{r.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading eyebrow="Sectors served" title="Trusted across industrial sectors" noWrap />
      <div class="grid grid-cols-2 sm:grid-cols- lg:grid-cols-5 gap-4">
        {clients.industries.map((ind) => <IndustryChip name={ind.name} icon={ind.icon as any} />)}
      </div>
    </div>
  </section>

  <section class="section-y section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="The track record"
        title={`${projects.length}+ projects delivered`}
        lead="Named clients, stated ratings."
        dark
      />
      <div class="grid sm:grid-cols-3 gap-6">
        {featuredProjects.map((p) => (
          <div class="rounded-md bg-white/5 border border-white/10 p-6">
            <p class="text-xs eyebrow mb-2">Marquee project</p>
            <p class="font-display font-bold text-paper text-sm mb-1">{p.client}</p>
            <p class="text-xs text-ink-200 mb-2">{p.location}</p>
            <p class="text-sm text-ink-200 leading-relaxed">{p.project}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading
        eyebrow="Who we work with"
        title="Clients & Associations"
        lead={`Registered vendor of ${clients.registeredVendorOf.length} major industrial groups.`}
      />
      <div class="grid md:grid-cols-2 gap-10">
        <div>
          <h3 class="font-display font-bold text-ink-900 text-lg mb-4 flex items-center gap-2">
            <Building2 class="size-5 text-amber-600" /> Registered Vendor Of
          </h3>
          <ul class="flex flex-col gap-2.5">
            {clients.registeredVendorOf.map((c) => (
              <li class="text-sm text-ink-900 py-2.5 px-4 rounded-md bg-paper border border-ink-100">{c}</li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-display font-bold text-ink-900 text-lg mb-4">Associated Consultants</h3>
          <ul class="flex flex-col gap-2.5">
            {clients.associatedConsultants.map((c) => (
              <li class="text-sm text-ink-900 py-2.5 px-4 rounded-md bg-paper border border-ink-100">{c}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page text-center">
      <a href="/about/quality/" class="inline-flex items-center gap-1.5 text-amber-600 font-semibold text-sm hover:gap-2.5 transition-all">
        See the CPRI type-test reports & certifications <ArrowRight class="size-4" />
      </a>
    </div>
  </section>

  <CTABand
    title="Want the full picture?"
    lead="See the CPRI type-test reports and every certification behind these numbers."
    showCall={false}
    glow={false}
  />
</BaseLayout>
