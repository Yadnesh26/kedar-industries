---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CTABand from '@/components/CTABand.astro';
import { Image, Picture } from 'astro:assets';
import * as icons from '@lucide/astro';
import { img } from '@/lib/images';
import company from '@/data/company.json';

// Placeholder facility photos — reused across sections for now, to be
// replaced with real per-area photography later.
const facilityImages = [
  'facility-metal-fabrication-welding-sample.webp',
  'facility-panel-assembly-workstations-sample.webp',
  'facility-cabinet-wiring-workstations-sample.webp',
];

const sections = [
  {
    icon: 'Hammer' as const,
    image: facilityImages[0],
    title: 'Dedicated Fabrication Section',
    description: 'Sheet-metal cutting, bending and structural fabrication for enclosures and busbar supports.',
    highlights: ['CNC shearing & cutting', 'Hydraulic press brakes', 'Structural fabrication jigs'],
  },
  {
    icon: 'LayoutGrid' as const,
    image: facilityImages[1],
    title: 'Electrical Panel Assembly Area',
    description: 'Component mounting, busbar installation and wiring across the full panel range.',
    highlights: ['Busbar fabrication & installation', 'Component mounting stations', 'Panel wiring benches'],
  },
  {
    icon: 'Flame' as const,
    image: facilityImages[2],
    title: 'Soldering & Brazing Section',
    description: 'Precision soldering and silver brazing for capacitor parts and electrical joints.',
    highlights: ['Precision soldering stations', 'Silver brazing for high-current joints', 'Capacitor component assembly'],
  },
  {
    icon: 'SearchCheck' as const,
    image: facilityImages[0],
    title: 'Quality Inspection Area',
    description: 'Dimensional checks, electrical testing and documentation before dispatch clearance.',
    highlights: ['Dimensional & visual inspection', 'Electrical testing rigs', 'Inspection documentation & traceability'],
  },
  {
    icon: 'PackageCheck' as const,
    image: facilityImages[1],
    title: 'Packing & Dispatch Department',
    description: 'Protective packing and dispatch coordination for safe, on-time delivery.',
    highlights: ['Protective crating & packing', 'Dispatch scheduling & coordination', 'Logistics documentation'],
  },
  {
    icon: 'Warehouse' as const,
    image: facilityImages[2],
    title: 'Material Storage Area',
    description: 'Organised raw-material and component storage supporting lean production flow.',
    highlights: ['Racked raw-material storage', 'Component bin organisation', 'Lean inventory flow'],
  },
];
---

<BaseLayout
  title="Manufacturing Infrastructure | Kedar Industries"
  description="8,000 sq ft manufacturing facility with 25 ft clear height — dedicated fabrication, panel assembly, soldering & brazing, quality inspection, and dispatch sections, all in-house at Kedar Industries, Nashik."
  path="/about/infrastructure/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About Us', href: '/about/' }, { label: 'Infrastructure' }]} />

  <section class="relative bg-ink-900 overflow-hidden">
    <div class="absolute inset-0">
      <Picture
        src={img('panel-apfc-batch-ready-for-dispatch-3.jpg')}
        alt=""
        widths={[480, 768, 1024, 1440, 1920, 2560]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        class="w-full h-full object-cover opacity-90 contrast-[1.3] saturate-[1.25]"
      />
      <div class="absolute inset-0 bg-ink-900/70"></div>
    </div>
    <div class="container-page relative py-20 sm:py-28 text-center">
      <p class="eyebrow mb-4">Manufacturing facility</p>
      <h1 class="text-paper text-4xl sm:text-5xl max-w-2xl mx-auto leading-[1.1]">
        {company.facility.areaSqFt.toLocaleString('en-IN')} sq ft. Every stage in-house.
      </h1>
      <p class="mt-6 text-lg text-ink-200 max-w-xl mx-auto leading-relaxed">
        A {company.facility.clearHeightFt} ft clear-height covered shed engineered for panel
        fabrication end to end — from raw sheet metal to a tested, dispatch-ready panel.
      </p>
    </div>
  </section>

  <section class="section-y pb-0">
    <div class="container-page">
      <SectionHeading eyebrow="Layout" title="Six dedicated production areas" lead="Every panel moves through the same disciplined sequence — from raw sheet metal to a tested, dispatch-ready unit." />
    </div>
  </section>

  {sections.map((s, i) => {
    const Icon = icons[s.icon];
    const dark = i % 2 === 1;
    const imageFirst = i % 2 === 0;
    return (
      <section class:list={['section-y', dark && 'section-diagonal-dark relative overflow-hidden']}>
        {dark && (
          <>
            <div class="section-diagonal-dark__edges" aria-hidden="true">
              <span></span><span></span><span></span>
            </div>
            <div class="absolute inset-0 opacity-[0.05] bg-[radial-gradient(circle_at_80%_20%,#FFC629,transparent_50%)]"></div>
          </>
        )}
        <div class="container-page relative grid lg:grid-cols-2 gap-10 items-center">
          <div class:list={[!imageFirst && 'lg:order-2']}>
            <Image
              src={img(s.image)}
              alt={s.title}
              width={640}
              height={480}
              class="rounded-2xl object-cover w-full aspect-[4/3] shadow-lg"
            />
          </div>
          <div class:list={[!imageFirst && 'lg:order-1']}>
            <p class:list={['eyebrow mb-3', dark && 'text-amber-500']}>Stage 0{i + 1}</p>
            <div class:list={['size-11 rounded-md flex items-center justify-center mb-4', dark ? 'bg-white/10' : 'bg-amber-100']}>
              <Icon class:list={['size-5', dark ? 'text-amber-500' : 'text-amber-600']} />
            </div>
            <h3 class:list={['font-display font-bold text-2xl sm:text-3xl mb-3', dark ? 'text-paper' : 'text-ink-900']}>{s.title}</h3>
            <p class:list={['leading-relaxed mb-6', dark ? 'text-ink-200' : 'text-ink-400']}>{s.description}</p>
            <ul class="flex flex-col gap-2.5">
              {s.highlights.map((h) => (
                <li
                  class:list={[
                    'flex items-center gap-3 rounded-md px-4 py-3 text-sm font-medium',
                    dark ? 'bg-white/5 text-ink-100' : 'bg-ink-100/60 text-ink-900',
                  ]}
                >
                  <icons.CircleCheck class:list={['size-4 shrink-0', dark ? 'text-amber-500' : 'text-amber-600']} />
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading eyebrow="Manufacturing strengths" title="What keeps production reliable" />
      <div class="flex flex-wrap gap-3">
        {company.manufacturingStrengths.map((item) => (
          <span class="px-4 py-2 rounded-full bg-paper border border-ink-100 text-sm font-medium text-ink-900">
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>
