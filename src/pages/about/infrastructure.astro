---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTABand from '@/components/CTABand.astro';
import { Image, Picture } from 'astro:assets';
import * as icons from '@lucide/astro';
import { img } from '@/lib/images';
import company from '@/data/company.json';

const sections = [
  {
    icon: 'Hammer' as const,
    image: 'facility-production-floor-team-02.jpg',
    title: 'Dedicated Fabrication Section',
    description: 'Sheet-metal cutting, bending and structural fabrication for enclosures and busbar supports.',
    highlights: ['CNC shearing & cutting of sheet metal to exact size', 'Hydraulic press brakes for clean, accurate bends', 'Structural fabrication jigs for repeatable assemblies'],
  },
  {
    icon: 'LayoutGrid' as const,
    image: 'facility-panel-assembly-testing-area.jpg',
    title: 'Electrical Panel Assembly Area',
    description: 'Component mounting, busbar installation and wiring across the full panel range.',
    highlights: ['Busbar fabrication & installation for every panel rating', 'Dedicated component mounting stations for each build', 'Panel wiring benches laid out for neat, traceable wiring'],
  },
  {
    icon: 'Flame' as const,
    image: 'facility-soldering-brazing-stations.jpg',
    title: 'Soldering & Brazing Section',
    description: 'Precision soldering and silver brazing for capacitor parts and electrical joints.',
    highlights: ['Precision soldering stations with trained operators', 'Silver brazing for strong, low-resistance high-current joints', 'Capacitor component assembly for production orders'],
  },
  {
    icon: 'SearchCheck' as const,
    image: 'facility-quality-inspection-height-gauge.jpg',
    title: 'Quality Inspection Area',
    description: 'Dimensional checks, electrical testing and documentation before dispatch clearance.',
    highlights: ['Dimensional & visual inspection against approved drawings', 'Electrical testing rigs to check every panel before dispatch', 'Inspection documentation & traceability for every order'],
  },
  {
    icon: 'PackageCheck' as const,
    image: 'facility-panel-packing-area.jpg',
    title: 'Packing & Dispatch Department',
    description: 'Protective packing and dispatch coordination for safe, on-time delivery.',
    highlights: ['Protective crating & packing to prevent transit damage', 'Dispatch scheduling & coordination with your site team', 'Complete logistics documentation sent with each consignment'],
  },
];
---

<BaseLayout
  title="Manufacturing Infrastructure | Kedar Industries"
  description="Kedar Industries runs an 8,000 sq ft facility in Nashik with a 25 ft clear height. Fabrication, panel assembly, soldering and brazing, quality inspection and dispatch each have their own section, all in-house."
  path="/about/infrastructure/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About Us', href: '/about/' }, { label: 'Infrastructure' }]} />

  <section class="relative bg-ink-900 overflow-hidden">
    <div class="absolute inset-0">
      <Picture
        src={img('facility-hero-production-floor.jpg')}
        alt=""
        widths={[480, 768, 1024, 1440]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        class="w-full h-full object-cover opacity-90 contrast-[1.3] saturate-[1.25]"
      />
      <div class="absolute inset-0 bg-ink-900/90"></div>
    </div>
    <div class="container-page relative py-20 sm:py-28 text-center">
      <p class="eyebrow mb-4">Manufacturing facility</p>
      <h1 class="text-paper text-4xl sm:text-5xl max-w-2xl mx-auto leading-[1.1]">
        {company.facility.areaSqFt.toLocaleString('en-IN')} sq ft. Every stage in-house.
      </h1>
      <p class="mt-6 text-lg text-ink-200 max-w-xl mx-auto leading-relaxed">
        A {company.facility.clearHeightFt} ft clear-height covered shed engineered for panel
        fabrication end to end, from raw sheet metal to a tested, dispatch-ready panel.
      </p>
    </div>
  </section>

  {sections.map((s, i) => {
    const Icon = icons[s.icon];
    const dark = i % 2 === 1;
    const imageFirst = i % 2 === 0;
    return (
      <section class:list={['section-y', dark && 'section-diagonal-dark relative overflow-hidden']}>
        {dark && (
          <div class="section-diagonal-dark__edges" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        )}
        <div class="container-page relative grid lg:grid-cols-2 gap-10 items-center">
          <div class:list={[!imageFirst && 'lg:order-2']}>
            <Image
              src={img(s.image)}
              alt={s.title}
              width={960}
              height={600}
              class="rounded-2xl object-cover w-full aspect-[16/10] shadow-lg"
            />
          </div>
          <div class:list={[!imageFirst && 'lg:order-1']}>
            <p class:list={['eyebrow mb-3', dark && 'text-amber-500']}>Stage 0{i + 1}</p>
            <div class:list={['size-11 rounded-md flex items-center justify-center mb-4', dark ? 'bg-white/10' : 'bg-amber-100']}>
              <Icon class:list={['size-5', dark ? 'text-amber-500' : 'text-amber-600']} />
            </div>
            <h3 class:list={['font-display font-bold text-2xl sm:text-3xl mb-3', dark ? 'text-paper' : 'text-ink-900']}>{s.title}</h3>
            <p class:list={['leading-relaxed mb-6', dark ? 'text-ink-200' : 'text-ink-400']}>{s.description}</p>
            <ul class="flex flex-col gap-2.5">
              {s.highlights.map((h) => (
                <li
                  class:list={[
                    'flex items-center gap-3 rounded-md px-4 py-3 text-sm font-medium',
                    dark ? 'bg-white/5 text-ink-100' : 'bg-ink-100/60 text-ink-900',
                  ]}
                >
                  <icons.CircleCheck class:list={['size-4 shrink-0', dark ? 'text-amber-500' : 'text-amber-600']} />
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}

  <CTABand />
</BaseLayout>
