---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import CTABand from '@/components/CTABand.astro';
import ImageSlideshow from '@/components/ImageSlideshow.astro';
import { Image, Picture } from 'astro:assets';
import * as icons from '@lucide/astro';
import { img } from '@/lib/images';
import company from '@/data/company.json';

const sections = [
  {
    icon: 'Hammer' as const,
    image: 'infra-cnc-punching.jpg',
    // a crossfade through the manufacturing shop, 4 s per photo, each tagged with its step
    slides: [
      { src: 'infra-cnc-punching.jpg', label: 'CNC Punching', alt: 'CNC turret punching machine cutting a sheet-metal panel' },
      { src: 'infra-cnc-bending.jpg', label: 'CNC Bending', alt: 'Operators bending sheet metal on a CNC press brake' },
      { src: 'infra-welding.jpg', label: 'Welding', alt: 'Welders building panel frames in the welding bay' },
      { src: 'infra-powder-coating.jpg', label: 'Powder Coating', alt: 'Powder coating spray booth and treatment line' },
      { src: 'infra-busbar-processing.jpg', label: 'Busbar Processing', alt: 'Busbar cutting, bending and punching station' },
    ],
    title: 'Dedicated Manufacturing Section',
    description: 'Sheet metal punching, bending, welding and powder coating for enclosure manufacturing, with busbar processing and supports for the electrical wiring.',
    highlights: [
      'Equipped with a reputed AMADA CNC Turret Punching Machine for precise and accurate sheet metal cutting and punching operations.',
      'Equipped with advanced CNC bending machines to ensure precise angles, accurate dimensions and consistent sheet metal forming.',
      'Advanced welding and assembly processes for strong, accurate and durable electrical panel enclosures.',
      'Powder Coating: High-quality powder coating for a uniform finish, corrosion resistance and long-lasting protection.',
      'Aluminium & Copper Busbar Processing: Precision cutting, bending, punching and assembly of aluminium and copper busbars to ensure reliable electrical connections and efficient current distribution.',
    ],
  },
  {
    icon: 'LayoutGrid' as const,
    image: 'infra-panel-assembly.jpg',
    title: 'Electrical Panel Assembly Area',
    description: 'Component mounting, busbar installation and wiring across the full panel range.',
    highlights: ['Busbar manufacturing & installation for every panel rating', 'Dedicated component mounting stations for each build', 'Panel wiring benches laid out for neat, traceable wiring'],
  },
  {
    icon: 'Cog' as const,
    // the presses are photographed portrait, so the two front views sit side by side
    // in a 3:2 frame, so each machine shows whole, head to feet
    image: 'infra-power-press-front.jpg',
    aspect: 'aspect-[3/2]',
    title: 'Advanced Power Press Section',
    description: 'Our advanced, high-quality power press machinery ensures precision, consistency and superior manufacturing standards.',
    highlights: ['C-frame power presses (DNX-35 and DNX-45) with dedicated control panels', 'Precise, repeatable pressing for consistent parts in every batch', 'Safety light curtains guarding the press tool area'],
  },
  {
    icon: 'Flame' as const,
    image: 'infra-soldering-brazing.jpg',
    title: 'Soldering & Brazing Section',
    description: 'Precision soldering and silver brazing for capacitor parts and electrical joints.',
    highlights: ['Precision soldering stations with trained operators', 'Silver brazing for strong, low-resistance high-current joints', 'Capacitor component assembly for production orders'],
  },
  {
    icon: 'SearchCheck' as const,
    image: 'facility-quality-inspection-height-gauge.jpg',
    title: 'Quality Inspection Area',
    description: 'Dimensional checks, electrical testing and documentation before dispatch clearance.',
    highlights: ['Dimensional & visual inspection against approved drawings', 'Electrical testing rigs to check every panel before dispatch', 'Inspection documentation & traceability for every order'],
  },
  {
    icon: 'PackageCheck' as const,
    image: 'facility-packing-dispatch-loading.jpg',
    title: 'Packing & Dispatch Department',
    description: 'Protective packing and dispatch coordination for safe, on-time delivery.',
    highlights: ['Protective crating & packing to prevent transit damage', 'Dispatch scheduling & coordination with your site team', 'Complete logistics documentation sent with each consignment'],
  },
];
---

<BaseLayout
  title="Manufacturing Infrastructure | Kedar Industries"
  description="Kedar Industries runs an 8,000 sq ft facility in Nashik with a 25 ft clear height. Manufacturing, panel assembly, power press, soldering and brazing, quality inspection and dispatch each have their own section, all in-house."
  path="/about/infrastructure/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About Us', href: '/about/' }, { label: 'Infrastructure' }]} />

  <section class="relative bg-ink-900 overflow-hidden">
    <div class="absolute inset-0">
      <Picture
        src={img('facility-hero-production-floor.jpg')}
        alt=""
        widths={[480, 768, 1024, 1440]}
        sizes="100vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        class="w-full h-full object-cover opacity-90 contrast-[1.3] saturate-[1.25]"
      />
      <div class="absolute inset-0 bg-ink-900/90"></div>
    </div>
    <div class="container-page relative py-20 sm:py-28 text-center">
      <p class="eyebrow mb-4">Manufacturing facility</p>
      <h1 class="text-paper text-4xl sm:text-5xl max-w-2xl mx-auto leading-[1.1]">
        {company.facility.areaSqFt.toLocaleString('en-IN')} sq ft. Every stage in-house.
      </h1>
      <p class="mt-6 text-lg text-ink-200 max-w-xl mx-auto leading-relaxed">
        A {company.facility.clearHeightFt} ft clear-height covered shed engineered for panel
        manufacturing end to end, from raw sheet metal to a tested, dispatch-ready panel.
      </p>
    </div>
  </section>

  {sections.map((s, i) => {
    const Icon = icons[s.icon];
    const dark = i % 2 === 1;
    const imageFirst = i % 2 === 0;
    return (
      <section class:list={['section-y', dark && 'section-diagonal-dark relative overflow-hidden']}>
        {dark && (
          <div class="section-diagonal-dark__edges" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
        )}
        <div class="container-page relative grid lg:grid-cols-2 gap-10 items-center">
          <div class:list={[!imageFirst && 'lg:order-2']}>
            {s.slides ? (
              <ImageSlideshow
                label={s.title}
                slides={s.slides}
                interval={4000}
                pauseOnHover={false}
                fadeMs={1600}
                controls={false}
                bordered={false}
                aspect="aspect-[16/10]"
                class="!shadow-lg"
              />
            ) : (
              <Image
                src={img(s.image)}
                alt={s.title}
                width={960}
                height={s.aspect ? 640 : 600}
                class:list={['rounded-2xl object-cover w-full shadow-lg', s.aspect ?? 'aspect-[16/10]']}
              />
            )}
          </div>
          <div class:list={[!imageFirst && 'lg:order-1']}>
            <p class:list={['eyebrow mb-3', dark && 'text-amber-500']}>Stage 0{i + 1}</p>
            <div class:list={['size-11 rounded-md flex items-center justify-center mb-4', dark ? 'bg-white/10' : 'bg-amber-100']}>
              <Icon class:list={['size-5', dark ? 'text-amber-500' : 'text-amber-600']} />
            </div>
            <h3 class:list={['font-display font-bold text-2xl sm:text-3xl mb-3', dark ? 'text-paper' : 'text-ink-900']}>{s.title}</h3>
            <p class:list={['leading-relaxed mb-6', dark ? 'text-ink-200' : 'text-ink-400']}>{s.description}</p>
            <ul class="flex flex-col gap-2.5">
              {s.highlights.map((h) => (
                <li
                  class:list={[
                    'flex items-start gap-3 rounded-md px-4 py-3 text-sm font-medium leading-relaxed',
                    dark ? 'bg-white/5 text-ink-100' : 'bg-ink-100/60 text-ink-900',
                  ]}
                >
                  <icons.CircleCheck class:list={['size-4 shrink-0 mt-0.5', dark ? 'text-amber-500' : 'text-amber-600']} />
                  {h.includes(': ') ? (
                    <span><strong class="font-semibold">{h.slice(0, h.indexOf(': ') + 1)}</strong>{h.slice(h.indexOf(': ') + 1)}</span>
                  ) : (
                    <span>{h}</span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    );
  })}

  <CTABand />
</BaseLayout>
