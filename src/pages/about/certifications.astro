---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CertCard from '@/components/CertCard.astro';
import PartnerCard from '@/components/PartnerCard.astro';
import Lightbox from '@/components/Lightbox.astro';
import CTABand from '@/components/CTABand.astro';
import { CircleCheck } from '@lucide/astro';
import certifications from '@/data/certifications.json';
import cpriTests from '@/data/cpri-tests.json';
import company from '@/data/company.json';

const { shortCircuit, temperatureRise, ip55 } = cpriTests;
---

<BaseLayout
  title="Certifications & CPRI Type-Test Reports | Kedar Industries"
  description="Kedar Industries' full certification record: CPRI type-test reports for short-circuit withstand (4000 A / 70 kA), temperature rise, and IP55 enclosure protection, plus ISO 9001/14001/45001, IATF 16949, ZED Silver, Vishay and C&S Electric partner authorizations."
  path="/about/certifications/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'About Us', href: '/about/' }, { label: 'Certifications' }]} />

  <section class="section-y">
    <div class="container-page">
      <SectionHeading
        eyebrow="The evidence"
        title="Independently verified by CPRI. Certified to five management-system standards."
        lead="This page holds the actual test reports and certificates — not a marketing summary of them. Every figure below is drawn from a numbered report or certificate you can view in full."
      />

      <div class="card overflow-hidden">
        <table class="w-full text-sm">
          <tbody>
            {certifications.cpriSummary.map((row, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-ink-100/40']}>
                <td class="px-5 py-3.5 flex items-center gap-2.5 text-ink-900">
                  <CircleCheck class="size-4 text-signal-green shrink-0" /> {row.parameter}
                </td>
                <td class="px-5 py-3.5 text-right font-mono-figure text-ink-900 font-semibold">{row.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 4.1 Short circuit -->
  <section class="section-y bg-ink-100/50" id="short-circuit">
    <div class="container-page">
      <p class="eyebrow mb-2">Report {shortCircuit.reportNumber}</p>
      <h2 class="text-2xl sm:text-3xl text-ink-900 mb-6">Short-Circuit Withstand Strength</h2>
      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm mb-6">
            <div><dt class="text-ink-400">Lab</dt><dd class="text-ink-900">{shortCircuit.lab}</dd></div>
            <div><dt class="text-ink-400">Sample</dt><dd class="text-ink-900">{shortCircuit.sample}</dd></div>
            <div><dt class="text-ink-400">Serial number</dt><dd class="text-ink-900 font-mono-figure">{shortCircuit.serialNumber}</dd></div>
            <div><dt class="text-ink-400">Standard</dt><dd class="text-ink-900">{shortCircuit.standard}</dd></div>
            <div><dt class="text-ink-400">Test date</dt><dd class="text-ink-900">{shortCircuit.tested}</dd></div>
            <div><dt class="text-ink-400">Report date</dt><dd class="text-ink-900">{shortCircuit.reportDate}</dd></div>
          </dl>

          <div class="card overflow-hidden mb-6">
            <table class="w-full text-xs">
              <thead>
                <tr class="bg-ink-800 text-paper text-left">
                  <th class="px-3 py-2.5 font-medium">Config.</th>
                  <th class="px-3 py-2.5 font-medium text-right">Peak (kA)</th>
                  <th class="px-3 py-2.5 font-medium text-right">Equiv. kA rms</th>
                  <th class="px-3 py-2.5 font-medium text-right">Duration</th>
                </tr>
              </thead>
              <tbody>
                {shortCircuit.results.map((r, i) => (
                  <tr class:list={[i % 2 === 1 && 'bg-ink-100/40']}>
                    <td class="px-3 py-2.5 text-ink-900">{r.configuration}</td>
                    <td class="px-3 py-2.5 text-right font-mono-figure">{r.peakKa}</td>
                    <td class="px-3 py-2.5 text-right font-mono-figure font-semibold text-amber-600">{r.equivalentKaRms}</td>
                    <td class="px-3 py-2.5 text-right font-mono-figure">{r.durationS}s</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          <p class="text-sm text-ink-400 mb-2"><strong class="text-ink-900">Observations:</strong> {shortCircuit.observations}</p>
          <p class="text-sm text-ink-400 mb-4"><strong class="text-ink-900">Conclusion:</strong> "{shortCircuit.conclusion}"</p>
        </div>
        <div>
          <p class="text-sm font-medium text-ink-900 mb-3">Report scans</p>
          <Lightbox images={shortCircuit.reportPages} groupId="sc" captionPrefix="Short-circuit report, page" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4.2 Temperature rise -->
  <section class="section-y" id="temperature-rise">
    <div class="container-page">
      <p class="eyebrow mb-2">Report {temperatureRise.reportNumber}</p>
      <h2 class="text-2xl sm:text-3xl text-ink-900 mb-6">Temperature Rise, Power-Frequency Withstand & Clearance/Creepage</h2>
      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm mb-6">
            <div><dt class="text-ink-400">Lab</dt><dd class="text-ink-900">{temperatureRise.lab}</dd></div>
            <div><dt class="text-ink-400">Sample</dt><dd class="text-ink-900">{temperatureRise.sample}</dd></div>
            <div><dt class="text-ink-400">Test current</dt><dd class="text-ink-900 font-mono-figure">{temperatureRise.testCurrentA} A</dd></div>
            <div><dt class="text-ink-400">Requirement</dt><dd class="text-ink-900">{temperatureRise.requirement}</dd></div>
            <div><dt class="text-ink-400">Test dates</dt><dd class="text-ink-900">{temperatureRise.testedDates}</dd></div>
            <div><dt class="text-ink-400">Ambient at shutdown</dt><dd class="text-ink-900 font-mono-figure">{temperatureRise.ambientAtShutdownC} °C</dd></div>
          </dl>

          <div class="card p-5 mb-6 bg-amber-100/40 border-amber-500/30">
            <p class="font-mono-figure text-3xl text-amber-600 font-semibold">{temperatureRise.maxRiseK} K</p>
            <p class="text-sm text-ink-900 mt-1">Maximum rise recorded — at {temperatureRise.maxRiseLocation} — against a {temperatureRise.maxRiseLimitK} K customer limit.</p>
          </div>

          <details class="card p-5 mb-6">
            <summary class="cursor-pointer font-medium text-ink-900 text-sm">Show all 32 thermocouple readings</summary>
            <div class="mt-4 overflow-x-auto">
              <table class="w-full text-xs">
                <thead>
                  <tr class="text-left border-b border-ink-100">
                    <th class="py-2 pr-3 font-medium text-ink-400">Location</th>
                    <th class="py-2 pr-3 font-medium text-ink-400">TC</th>
                    <th class="py-2 pr-3 font-medium text-ink-400 text-right">Max °C</th>
                    <th class="py-2 font-medium text-ink-400 text-right">Rise (K)</th>
                  </tr>
                </thead>
                <tbody>
                  {temperatureRise.readings.map((r) => (
                    <tr class="border-b border-ink-100/60">
                      <td class="py-1.5 pr-3 text-ink-900">{r.location}</td>
                      <td class="py-1.5 pr-3 font-mono-figure text-ink-400">{r.tc}</td>
                      <td class="py-1.5 pr-3 text-right font-mono-figure">{r.maxTempC}</td>
                      <td class:list={['py-1.5 text-right font-mono-figure font-semibold', r.riseK === temperatureRise.maxRiseK ? 'text-amber-600' : 'text-ink-900']}>{r.riseK}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>

          <p class="text-sm text-ink-400 mb-1"><strong class="text-ink-900">HV withstand:</strong> {temperatureRise.hvWithstand.voltageKvRms} kV rms, withstood {temperatureRise.hvWithstand.durationS}s across all five configurations.</p>
          <p class="text-sm text-ink-400"><strong class="text-ink-900">Clearance / creepage:</strong> {temperatureRise.clearanceMm} mm / {temperatureRise.creepageMm} mm — within limits for pollution degree 3, material group IIIa.</p>
        </div>
        <div>
          <p class="text-sm font-medium text-ink-900 mb-3">Report scans</p>
          <Lightbox images={temperatureRise.reportPages} groupId="tr" captionPrefix="Temperature rise report, page" />
        </div>
      </div>
    </div>
  </section>

  <!-- 4.3 IP55 -->
  <section class="section-y bg-ink-100/50" id="ip55">
    <div class="container-page">
      <p class="eyebrow mb-2">Report {ip55.reportNumber}</p>
      <h2 class="text-2xl sm:text-3xl text-ink-900 mb-6">Degree of Protection — IP55</h2>
      <div class="grid lg:grid-cols-2 gap-10">
        <div>
          <dl class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm mb-6">
            <div><dt class="text-ink-400">Lab</dt><dd class="text-ink-900">{ip55.lab}</dd></div>
            <div><dt class="text-ink-400">Sample</dt><dd class="text-ink-900">{ip55.sample}</dd></div>
            <div><dt class="text-ink-400">Standard</dt><dd class="text-ink-900">{ip55.standard}</dd></div>
            <div><dt class="text-ink-400">Test dates</dt><dd class="text-ink-900">{ip55.testedDates}</dd></div>
          </dl>
          <div class="grid sm:grid-cols-2 gap-4 mb-6">
            <div class="card p-5">
              <p class="font-mono-figure text-2xl text-amber-600 font-semibold">IP-5X</p>
              <p class="text-xs text-ink-400 mt-1 mb-2">{ip55.ip5x.date}</p>
              <p class="text-sm text-ink-900">{ip55.ip5x.method}</p>
              <p class="text-sm text-signal-green font-medium mt-2">✔ {ip55.ip5x.result}</p>
            </div>
            <div class="card p-5">
              <p class="font-mono-figure text-2xl text-amber-600 font-semibold">IP-X5</p>
              <p class="text-xs text-ink-400 mt-1 mb-2">{ip55.ipx5.date}</p>
              <p class="text-sm text-ink-900">{ip55.ipx5.method}</p>
              <p class="text-sm text-signal-green font-medium mt-2">✔ {ip55.ipx5.result}</p>
            </div>
          </div>
          <p class="text-sm text-ink-400">"{ip55.conclusion}"</p>
        </div>
        <div>
          <p class="text-sm font-medium text-ink-900 mb-3">Report scans</p>
          <Lightbox images={ip55.reportPages} groupId="ip" captionPrefix="IP55 report, page" />
        </div>
      </div>
    </div>
  </section>

  <!-- Management systems -->
  <section class="section-y">
    <div class="container-page">
      <SectionHeading eyebrow="Management systems" title="Five audited certifications" />
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {certifications.managementSystems.map((c) => (
          <CertCard name={c.name} number={c.number} body={c.body} />
        ))}
      </div>
    </div>
  </section>

  <!-- Partner authorizations -->
  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading eyebrow="Partner authorizations" title="Licensed, not just reselling" />
      <div class="grid md:grid-cols-2 gap-6 mb-8">
        {certifications.partnerships.map((p) => (
          <PartnerCard partner={p.partner} role={p.role} scope={p.scope} validTill={p.validTill} logo={p.logo} />
        ))}
      </div>
      <div class="grid sm:grid-cols-2 gap-4">
        {certifications.partnerships.map((p) => (
          <div>
            <p class="text-sm font-medium text-ink-900 mb-3">{p.partner} — signed letter/certificate</p>
            <Lightbox images={[p.certScan]} groupId={`partner-${p.partner.slice(0, 6)}`} captionPrefix={p.partner} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Statutory registrations -->
  <section class="section-y">
    <div class="container-page">
      <SectionHeading eyebrow="Statutory registrations" title="Full compliance record" />
      <details class="card overflow-hidden">
        <summary class="cursor-pointer px-5 py-4 font-medium text-ink-900 text-sm bg-ink-100/50">
          Show all {company.registrations.length} registrations
        </summary>
        <table class="w-full text-sm">
          <tbody>
            {company.registrations.map((r, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-ink-100/40']}>
                <th scope="row" class="text-left font-medium text-ink-400 px-5 py-3 w-1/2">{r.name}</th>
                <td class="px-5 py-3 font-mono-figure text-ink-900">{r.number}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </details>
    </div>
  </section>

  <CTABand />
</BaseLayout>
