---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCarousel from '@/components/ProductCarousel.astro';
import CTABand from '@/components/CTABand.astro';
import * as icons from '@lucide/astro';
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

const coreServices = [
  { image: 'service-precision-soldering-stations.jpg', title: 'Precision Soldering', description: 'Precision soldering activity for capacitor components and electrical assemblies, to tight dimensional and contact-quality tolerances.' },
  { image: 'service-copper-connector-brazing-station.jpg', title: 'Silver Brazing / Electrical Joints Brazing', description: 'Silver brazing and electrical joint brazing for reliable, low-resistance high-current connections.' },
  { image: 'service-component-assembly-benches.jpg', title: 'Capacitor Component Assembly', description: 'Full component assembly for capacitor manufacturers, from terminals and busbars to finished sub-assemblies.' },
  { image: 'service-panel-assembly-testing-area.jpg', title: 'Installation & Commissioning', description: 'Professional installation by qualified engineers, covering setup, alignment, testing, performance verification and operator guidance.' },
  { image: 'service-maintenance-inspection.jpg', title: 'Annual Maintenance Contract (AMC)', description: 'Planned preventive maintenance, routine inspections, and performance optimisation to extend equipment life.' },
  { image: 'service-spare-parts-store.jpg', title: 'Genuine Spare Parts', description: 'High-quality genuine replacement parts, quickly supplied to avoid interrupted operations.' },
];

const whyChoose = [
  'Experienced technical team',
  'Cost-effective, transparent pricing',
  'Integrated end-to-end capability, from design to dispatch',
  'Compliance with IS/IEC industry safety standards',
  'Timely execution and dependable support',
  'Deep application expertise across sectors',
];
---

<BaseLayout
  title="Services | Kedar Industries"
  description="Kedar Industries offers precision soldering, silver brazing, capacitor component assembly, installation and commissioning, AMC and genuine spares."
  path="/services/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />

  <section class="py-14 sm:py-16 section-diagonal-dark section-diagonal-dark--bottom-only">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="What we do beyond the panel"
        title="Services"
        lead="From precision fabrication activities to full lifecycle support after the panel is installed."
        dark
        align="center"
      />
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <ProductCarousel>
        {coreServices.map((s) => (
          <div class="w-[85vw] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4.5rem)/4)] shrink-0">
            <a href="/contact/" class="service-card card group flex flex-col overflow-hidden h-full">
              <div class="aspect-[4/3] overflow-hidden">
                <Image
                  src={img(s.image)}
                  alt={s.title}
                  width={480}
                  height={300}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="p-5 flex flex-col items-center text-center gap-1.5 flex-1">
                <h3 class="font-display font-bold text-base text-ink-900">{s.title}</h3>
                <p class="text-sm text-ink-400 leading-relaxed line-clamp-2">{s.description}</p>
                <span class="mt-2 inline-flex items-center gap-1.5 text-amber-600 font-semibold text-sm group-hover:gap-2.5 transition-all">
                  Submit Enquiry <ArrowRight class="size-3.5" />
                </span>
              </div>
            </a>
          </div>
        ))}
      </ProductCarousel>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <SectionHeading eyebrow="Why choose our services" title="Built around dependability" />
      <ul class="grid sm:grid-cols-2 gap-4">
        {whyChoose.map((item) => (
          <li class="flex items-start gap-3 text-sm text-ink-900 card p-4">
            <icons.CircleCheck class="size-4 text-amber-600 shrink-0 mt-0.5" /> {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTABand showCall={false} />
</BaseLayout>

<style>
  .service-card {
    border-color: transparent;
    box-shadow: 0 1px 4px rgba(14, 17, 22, 0.08);
  }
</style>
