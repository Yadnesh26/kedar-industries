---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import CTABand from '@/components/CTABand.astro';
import * as icons from '@lucide/astro';
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import { img } from '@/lib/images';
import company from '@/data/company.json';

const coreServices = [
  { image: 'service-precision-soldering.jpg', title: 'Precision Soldering', description: 'Precision soldering activity for capacitor components and electrical assemblies, to tight dimensional and contact-quality tolerances.' },
  { image: 'service-silver-brazing-electrical-joints.jpg', title: 'Silver Brazing / Electrical Joints Brazing', description: 'Silver brazing and electrical joint brazing for reliable, low-resistance high-current connections.' },
  { image: 'service-capacitor-component-assembly.jpg', title: 'Capacitor Component Assembly', description: 'Full component assembly for capacitor manufacturers, from terminals and busbars to finished sub-assemblies.' },
  { image: 'service-installation-commissioning.jpg', title: 'Installation & Commissioning', description: 'Professional installation by qualified engineers — setup, alignment, testing, performance verification and operator guidance.' },
  { image: 'service-precision-soldering.jpg', title: 'Annual Maintenance Contract (AMC)', description: 'Planned preventive maintenance, routine inspections, and performance optimisation to extend equipment life.' },
  { image: 'service-silver-brazing-electrical-joints.jpg', title: 'Genuine Spare Parts', description: 'High-quality genuine replacement parts, quickly supplied to avoid interrupted operations.' },
];

const whyChoose = [
  'Experienced technical team',
  'Cost-effective, transparent pricing',
  'Integrated end-to-end capability — design to dispatch',
  'Compliance with IS/IEC industry safety standards',
  'Timely execution and dependable support',
  'Deep application expertise across sectors',
];
---

<BaseLayout
  title="Services | Kedar Industries"
  description="Precision soldering, silver brazing, capacitor component assembly, installation & commissioning, AMC and genuine spares from Kedar Industries — plus 24×7 remote technical support."
  path="/services/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />

  <section class="py-14 sm:py-16 section-diagonal-dark section-diagonal-dark--bottom-only">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="What we do beyond the panel"
        title="Services"
        lead="From precision fabrication activities to full lifecycle support after the panel is installed."
        dark
        align="center"
      />
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {coreServices.map((s) => (
          <a href="/contact/" class="service-card card group flex flex-col overflow-hidden h-full">
            <div class="aspect-[4/3] overflow-hidden">
              <Image
                src={img(s.image)}
                alt={s.title}
                width={480}
                height={300}
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
            </div>
            <div class="p-5 flex flex-col items-center text-center gap-1.5 flex-1">
              <h3 class="font-display font-bold text-base text-ink-900">{s.title}</h3>
              <p class="text-sm text-ink-400 leading-relaxed line-clamp-2">{s.description}</p>
              <span class="mt-2 inline-flex items-center gap-1.5 text-amber-600 font-semibold text-sm group-hover:gap-2.5 transition-all">
                Submit Enquiry <ArrowRight class="size-3.5" />
              </span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading eyebrow="Active support" title="Remote & round-the-clock technical support" dark
        lead="Assistance via phone, email and online support — immediate troubleshooting guidance and round-the-clock support for critical service requirements." />
      <a href={`tel:${company.phoneHref}`} class="btn btn-primary">Call {company.phone}</a>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page">
      <SectionHeading eyebrow="Why choose our services" title="Built around dependability" />
      <ul class="grid sm:grid-cols-2 gap-4">
        {whyChoose.map((item) => (
          <li class="flex items-start gap-3 text-sm text-ink-900 card p-4">
            <icons.CircleCheck class="size-4 text-amber-600 shrink-0 mt-0.5" /> {item}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTABand showCall={false} />
</BaseLayout>

<style>
  .service-card {
    border-color: transparent;
    box-shadow: 0 1px 4px rgba(14, 17, 22, 0.08);
  }
</style>
