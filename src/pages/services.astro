---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProductCarousel from '@/components/ProductCarousel.astro';
import CTABand from '@/components/CTABand.astro';
import * as icons from '@lucide/astro';
import { ArrowRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

const coreServices = [
  { image: 'service-precision-soldering-stations.jpg', title: 'Precision Soldering', description: 'Precision soldering activity for capacitor components and electrical assemblies, to tight dimensional and contact-quality tolerances.' },
  { image: 'service-copper-connector-brazing-station.jpg', title: 'Silver Brazing / Electrical Joints Brazing', description: 'Silver brazing and electrical joint brazing for reliable, low-resistance high-current connections.' },
  { image: 'service-component-assembly-benches.jpg', title: 'Capacitor Component Assembly', description: 'Full component assembly for capacitor manufacturers, from terminals and busbars to finished sub-assemblies.' },
  { image: 'service-panel-assembly-testing-area.jpg', title: 'Installation & Commissioning', description: 'Professional installation by qualified engineers, covering setup, alignment, testing, performance verification and operator guidance.' },
  { image: 'service-maintenance-inspection.jpg', title: 'Annual Maintenance Contract (AMC)', description: 'Planned preventive maintenance, routine inspections, and performance optimisation to extend equipment life.' },
  { image: 'service-spare-parts-store.jpg', title: 'Genuine Spare Parts', description: 'High-quality genuine replacement parts, quickly supplied to avoid interrupted operations.' },
];

// UPS, batteries & power backup.
const upsOfferings = [
  {
    image: 'service-ups-systems-v5.jpg',
    title: 'UPS Systems',
    points: [
      'Supply of UPS systems for industrial, commercial and critical power applications.',
      'Online UPS solutions for sensitive equipment and critical loads.',
      'Assistance with UPS capacity selection based on load requirements and application needs.',
      'UPS installation, commissioning, inspection and preventive maintenance.',
    ],
  },
  {
    image: 'service-ups-batteries.jpg',
    title: 'Batteries & Battery Bank Solutions',
    points: [
      'Supply and replacement of batteries for UPS and backup power systems.',
      'Battery bank inspection and maintenance.',
      'Battery health assessment and performance checks.',
      'Battery replacement planning and support for improving backup reliability.',
      'Assistance with battery selection based on UPS compatibility, backup time and application requirements.',
    ],
  },
  {
    image: 'service-ups-amc-v2.jpg',
    title: 'UPS AMC & Technical Services',
    points: [
      'Annual Maintenance Contracts (AMC) for UPS systems and associated battery banks.',
      'Preventive maintenance and routine system health checks.',
      'UPS fault diagnosis and troubleshooting.',
      'Battery inspection, testing and replacement support.',
      'Breakdown maintenance and technical assistance, subject to service coverage and agreed response terms.',
      'UPS performance assessment and recommendations for improving system reliability.',
    ],
  },
];

const upsWhyChoose = [
  'Application-oriented UPS and battery recommendations',
  'Product supply and replacement support',
  'Preventive maintenance and AMC options',
  'Technical troubleshooting and service assistance',
  'Solutions tailored to customer requirements',
  'Support for new installations and existing UPS systems, subject to technical compatibility and service availability',
];

---

<BaseLayout
  title="Services | Kedar Industries"
  description="Kedar Industries offers precision soldering, silver brazing, capacitor component assembly, installation and commissioning, AMC, genuine spares, and UPS systems, batteries and power backup services."
  path="/services/"
>
  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Services' }]} />

  <section class="py-14 sm:py-16 section-diagonal-dark section-diagonal-dark--bottom-only">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading
        eyebrow="What we do beyond the panel"
        title="Services"
        lead="From precision fabrication activities to full lifecycle support after the panel is installed."
        dark
        align="center"
      />
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <ProductCarousel>
        {coreServices.map((s) => (
          <div class="w-[85vw] sm:w-[calc((100%-1.5rem)/2)] lg:w-[calc((100%-4.5rem)/4)] shrink-0">
            <a href="/contact/" class="service-card card group flex flex-col overflow-hidden h-full">
              <div class="aspect-[4/3] overflow-hidden">
                <Image
                  src={img(s.image)}
                  alt={s.title}
                  width={480}
                  height={300}
                  class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="p-5 flex flex-col items-center text-center gap-1.5 flex-1">
                <h3 class="font-display font-bold text-base text-ink-900">{s.title}</h3>
                <p class="text-sm text-ink-400 leading-relaxed line-clamp-2">{s.description}</p>
                <span class="mt-2 inline-flex items-center gap-1.5 text-amber-600 font-semibold text-sm group-hover:gap-2.5 transition-all">
                  Submit Enquiry <ArrowRight class="size-3.5" />
                </span>
              </div>
            </a>
          </div>
        ))}
      </ProductCarousel>
    </div>
  </section>

  <!-- UPS systems, batteries & power backup -->
  <section id="ups" class="section-y scroll-mt-16">
    <div class="container-page grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      <div>
        <SectionHeading
          eyebrow="Reliable power backup. Professional service. Uninterrupted operations."
          title="UPS Systems, Batteries & Power Backup Solutions"
          class="!mb-6"
        />
        <div class="flex flex-col gap-4 text-ink-400 leading-relaxed">
          <p>
            Kedar Industries offers UPS systems, battery solutions and professional power backup services for
            industrial, commercial and institutional applications. We support customers in selecting suitable power
            backup solutions, maintaining system reliability and minimising downtime through planned maintenance and
            responsive technical service.
          </p>
          <p>
            Our solutions are intended to support critical electrical loads, IT infrastructure, industrial equipment,
            commercial facilities and other applications requiring dependable backup power.
          </p>
        </div>
      </div>
      <div class="rounded-2xl overflow-hidden shadow-sm">
        <Image
          src={img('service-ups-overview.jpg')}
          alt="Kedar Industries technician servicing a UPS system beside its battery bank"
          width={1200}
          height={900}
          class="w-full aspect-[4/3] object-cover"
        />
      </div>
    </div>
  </section>

  <section class="section-y section-diagonal-dark">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative">
      <SectionHeading eyebrow="Power backup" title="Our Products & Services" dark />
      <div class="grid md:grid-cols-3 gap-6">
        {upsOfferings.map((o, i) => (
          <div class="rounded-md bg-white/5 border border-white/10 overflow-hidden flex flex-col">
            <Image src={img(o.image)} alt={o.title} width={800} height={600} class="w-full aspect-[4/3] object-cover" />
            <div class="p-6 flex flex-col gap-4">
              <div class="flex items-baseline gap-3">
                <span class="font-mono-figure text-sm font-semibold text-amber-500">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="font-display font-bold text-paper text-lg leading-snug">{o.title}</h3>
              </div>
              <ul class="flex flex-col gap-2.5">
                {o.points.map((pt) => (
                  <li class="flex items-start gap-2.5 text-sm text-ink-200 leading-relaxed">
                    <icons.CircleCheck class="size-4 text-amber-500 shrink-0 mt-0.5" /> {pt}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <SectionHeading eyebrow="UPS & power backup" title="Why choose Kedar Industries?" />
      <ul class="grid sm:grid-cols-2 gap-4 mb-10">
        {upsWhyChoose.map((item) => (
          <li class="flex items-start gap-3 text-sm text-ink-900 card p-4">
            <icons.CircleCheck class="size-4 text-amber-600 shrink-0 mt-0.5" /> {item}
          </li>
        ))}
      </ul>
      <div class="rounded-md bg-ink-900 p-6 sm:p-8 flex flex-col md:flex-row md:items-center md:justify-between gap-5">
        <div>
          <p class="font-display font-bold text-paper text-lg sm:text-xl">Looking for a UPS, battery replacement or annual maintenance solution?</p>
          <p class="text-sm text-ink-200 mt-1.5">Contact Kedar Industries to discuss your power backup requirements and receive a suitable technical and commercial proposal.</p>
        </div>
        <a href="/contact/" class="btn btn-primary justify-center shrink-0">Contact Us <ArrowRight class="size-4" /></a>
      </div>
    </div>
  </section>

  <CTABand showCall={false} />
</BaseLayout>

<style>
  .service-card {
    border-color: transparent;
    box-shadow: 0 1px 4px rgba(14, 17, 22, 0.08);
  }
</style>
