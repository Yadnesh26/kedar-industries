---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumb from '@/components/Breadcrumb.astro';
import ProductCard from '@/components/ProductCard.astro';
import CTABand from '@/components/CTABand.astro';
import { Image } from 'astro:assets';
import { CircleCheck, ArrowRight } from '@lucide/astro';
import { img } from '@/lib/images';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const parts = (await getCollection('parts')).sort((a, b) => a.data.order - b.data.order);
  return parts.map((part) => ({
    params: { slug: part.id },
    props: { part, allParts: parts },
  }));
}

const { part, allParts } = Astro.props;
const { data, id } = part;
const photos = [data.heroImage, ...data.gallery];
const others = allParts.filter((p) => p.id !== id).slice(0, 4);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: data.name,
  description: data.tagline,
  brand: { '@type': 'Brand', name: 'Kedar Industries' },
  manufacturer: {
    '@type': 'Organization',
    name: 'Kedar Industries',
    url: 'https://kedarindustries.net/',
  },
};
---

<BaseLayout
  title={`${data.name} | Kedar Industries`}
  description={data.tagline}
  path={`/capacitor-parts/${id}/`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Capacitor Parts', href: '/products/#capacitor-parts' }, { label: data.name }]} />

  <section class="py-10 sm:py-14 section-diagonal-dark section-diagonal-dark--bottom-only">
    <div class="section-diagonal-dark__edges" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="container-page relative text-center">
      <h1 class="text-paper text-3xl sm:text-4xl leading-[1.1]">{data.name}</h1>
      <p class="mt-4 text-lg text-ink-200 max-w-2xl mx-auto leading-relaxed">{data.tagline}</p>
    </div>
  </section>

  <section class="section-y">
    <div class="container-page grid lg:grid-cols-3 gap-12">
      <div class="lg:col-span-2 grid xl:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] gap-10 items-start">
        <div class="part-gallery w-full max-w-md xl:max-w-none" data-part-gallery>
          <div class="rounded-md border border-ink-100 bg-paper aspect-square p-10 flex items-center justify-center">
            {photos.map((file, i) => (
              <Image
                src={img(file)}
                alt={i === 0 ? data.name : `${data.name}, view ${i + 1}`}
                width={800}
                loading={i === 0 ? 'eager' : 'lazy'}
                data-gallery-slide={i}
                class:list={['max-w-full max-h-full w-auto h-auto object-contain mix-blend-multiply', i !== 0 && 'hidden']}
              />
            ))}
          </div>

          {photos.length > 1 && (
            <div class="mt-3 grid grid-cols-4 gap-2" role="tablist" aria-label={`${data.name} photos`}>
              {photos.map((file, i) => (
                <button
                  type="button"
                  role="tab"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={`Show photo ${i + 1}`}
                  data-gallery-thumb={i}
                  class="gallery-thumb aspect-square rounded bg-paper p-2 flex items-center justify-center border-2 border-ink-100 transition-colors hover:border-amber-500/60"
                >
                  <Image src={img(file)} alt="" width={160} class="max-w-full max-h-full w-auto h-auto object-contain mix-blend-multiply" />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="flex flex-col gap-8">
          <div>
            <h2 class="text-2xl text-ink-900 mb-4">Overview</h2>
            <p class="text-ink-400 leading-relaxed">{data.overview}</p>
          </div>
  
          <div>
            <h2 class="text-2xl text-ink-900 mb-4">Features</h2>
            <ul class="flex flex-col gap-3">
              {data.features.map((f: string) => (
                <li class="flex items-start gap-2.5 text-sm text-ink-600">
                  <CircleCheck class="size-4 text-amber-600 shrink-0 mt-0.5" /> {f}
                </li>
              ))}
            </ul>
          </div>
  
          <div>
            <h2 class="text-2xl text-ink-900 mb-4">Applications</h2>
            <ul class="flex flex-wrap gap-2">
              {data.applications.map((a: string) => (
                <li class="px-3 py-1.5 rounded-full bg-ink-100 text-sm text-ink-900">{a}</li>
              ))}
            </ul>
          </div>
  
          <div>
            <a href="/contact/" class="btn btn-primary">Request a Quote <ArrowRight class="size-4" /></a>
          </div>
        </div>
      </div>

      <aside class="flex flex-col gap-6 lg:sticky lg:top-24 self-start">
        <div class="card overflow-hidden">
          <div class="px-5 py-4 border-b border-ink-100 bg-ink-100/50">
            <h3 class="font-display font-bold text-ink-900 text-sm">Capacitor Parts</h3>
          </div>
          <ul class="flex flex-col divide-y divide-ink-100">
            {allParts.map((p) => (
              <li>
                <a
                  href={`/capacitor-parts/${p.id}/`}
                  aria-current={p.id === id ? 'page' : undefined}
                  class:list={[
                    'flex items-center justify-between gap-3 px-5 py-3 text-sm transition-colors',
                    p.id === id
                      ? 'bg-amber-500 text-ink-900 font-semibold'
                      : 'text-ink-600 hover:bg-ink-100/60 hover:text-amber-600',
                  ]}
                >
                  {p.data.name}
                  <ArrowRight class="size-3.5 shrink-0" />
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="card p-6">
          <h3 class="font-display font-bold text-ink-900 text-base mb-2">Made to your drawing</h3>
          <p class="text-sm text-ink-400 leading-relaxed mb-6">
            Send us your drawing or sample and the quantity you need, and we will come back with a quote.
          </p>
          <a href="/contact/" class="btn btn-primary w-full justify-center">Request a Quote</a>
        </div>
      </aside>
    </div>
  </section>

  <section class="section-y bg-ink-100/50">
    <div class="container-page">
      <h2 class="text-2xl sm:text-3xl text-ink-900 mb-8">Other Capacitor Parts</h2>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {others.map((p) => (
          <ProductCard
            href={`/capacitor-parts/${p.id}/`}
            name={p.data.name}
            tagline={p.data.tagline}
            heroImage={p.data.heroImage}
            compact
          />
        ))}
      </div>
    </div>
  </section>

  <CTABand showCall={false} />
</BaseLayout>

<style>
  .gallery-thumb[aria-selected='true'] {
    border-color: var(--color-amber-500);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-part-gallery]').forEach((gallery) => {
    const slides = gallery.querySelectorAll<HTMLElement>('[data-gallery-slide]');
    const thumbs = gallery.querySelectorAll<HTMLButtonElement>('[data-gallery-thumb]');
    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = thumb.dataset.galleryThumb;
        slides.forEach((s) => s.classList.toggle('hidden', s.dataset.gallerySlide !== index));
        thumbs.forEach((t) => t.setAttribute('aria-selected', String(t === thumb)));
      });
    });
  });
</script>
