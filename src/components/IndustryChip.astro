---
import * as icons from '@lucide/astro';

interface Props {
  name: string;
  icon: keyof typeof icons;
}
const { name, icon } = Astro.props;
const Icon = (icons[icon] ?? icons.Factory) as typeof icons.Factory;
---

<div class="rounded-md border border-ink-100 bg-paper overflow-hidden hover:border-amber-500 transition-colors">
  <div class="flex items-center justify-center py-6 bg-ink-100/60">
    <Icon class="size-7 text-amber-600" />
  </div>
  <div class="px-3 py-2.5 bg-ink-900 text-center">
    <span class="text-xs font-semibold text-paper">{name}</span>
  </div>
</div>
