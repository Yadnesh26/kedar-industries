---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

interface Props {
  name: string;
  image: string;
}
const { name, image } = Astro.props;
---

<div class="group rounded-md overflow-hidden border border-ink-100 bg-paper hover:border-amber-500 transition-colors">
  <div class="aspect-[4/3] overflow-hidden">
    <Image
      src={img(image)}
      alt={name}
      width={320}
      height={240}
      fit="cover"
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="px-3 py-2.5 bg-ink-900 text-center">
    <span class="text-xs font-semibold text-paper">{name}</span>
  </div>
</div>
