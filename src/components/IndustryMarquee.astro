---
import IndustryChip from './IndustryChip.astro';

interface Industry {
  name: string;
  icon: string;
}
interface Props {
  industries: Industry[];
}
const { industries } = Astro.props;
const track = [...industries, ...industries];
---

<div class="industry-marquee overflow-hidden max-w-[1100px] mx-auto">
  <div class="industry-marquee__track flex w-max gap-6">
    {track.map((ind) => (
      <div class="shrink-0 w-64">
        <IndustryChip name={ind.name} icon={ind.icon as any} />
      </div>
    ))}
  </div>
</div>

<style>
  .industry-marquee__track {
    animation: industry-marquee 36s linear infinite;
  }
  .industry-marquee:hover .industry-marquee__track {
    animation-play-state: paused;
  }
  @keyframes industry-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .industry-marquee__track {
      animation: none;
    }
  }
</style>
