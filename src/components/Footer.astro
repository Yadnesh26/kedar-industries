---
import { Phone, Mail, MapPin, Clock, Linkedin } from '@lucide/astro';
import company from '@/data/company.json';
import nav from '@/data/nav.json';
import { img } from '@/lib/images';
import { Image } from 'astro:assets';

const logo = img('logo-wordmark-on-dark.svg');
const year = new Date().getFullYear();
---

<footer class="bg-ink-900 text-ink-200">
  <div class="container-page py-16 grid grid-cols-1 md:grid-cols-4 gap-10">
    <div>
      <a href="/" class="inline-block mb-5" aria-label="Kedar Industries home">
        <Image src={logo} alt="Kedar Industries" width={220} height={68} class="h-12 w-auto object-contain" />
      </a>
      <p class="text-sm text-ink-400 leading-relaxed mb-4">
        {company.tagline}
      </p>
      <p class="text-xs text-ink-400 font-mono-figure">
        CPRI Type-Tested · IEC 61439 · ISO 9001/14001/45001 · IATF 16949
      </p>
    </div>

    <div>
      <h3 class="font-display font-bold text-paper text-sm uppercase tracking-wide mb-4">
        Quick Links
      </h3>
      <ul class="flex flex-col gap-2.5 text-sm">
        {nav.footerQuickLinks.map((link) => (
          <li><a href={link.href} class="text-ink-400 hover:text-amber-500 transition-colors">{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="font-display font-bold text-paper text-sm uppercase tracking-wide mb-4">
        Products
      </h3>
      <ul class="flex flex-col gap-2.5 text-sm">
        <li><a href="/products/pcc-panel/" class="text-ink-400 hover:text-amber-500 transition-colors">PCC Panel</a></li>
        <li><a href="/products/mcc-panel/" class="text-ink-400 hover:text-amber-500 transition-colors">MCC Panel</a></li>
        <li><a href="/products/apfc-panel/" class="text-ink-400 hover:text-amber-500 transition-colors">APFC Panel</a></li>
        <li><a href="/products/rtpfc-panel/" class="text-ink-400 hover:text-amber-500 transition-colors">RTPFC Panel</a></li>
        <li><a href="/products/" class="text-amber-500 hover:text-amber-600 transition-colors font-medium">View all products →</a></li>
      </ul>
    </div>

    <div>
      <h3 class="font-display font-bold text-paper text-sm uppercase tracking-wide mb-4">
        Contact
      </h3>
      <ul class="flex flex-col gap-3 text-sm text-ink-400">
        <li class="flex gap-2.5"><MapPin class="size-4 shrink-0 mt-0.5 text-amber-500" /><span>{company.address.full}</span></li>
        <li class="flex gap-2.5"><Phone class="size-4 shrink-0 text-amber-500" /><a href={`tel:${company.phoneHref}`} class="hover:text-amber-500 font-mono-figure">{company.phone}</a></li>
        <li class="flex gap-2.5"><Mail class="size-4 shrink-0 text-amber-500" /><a href={`mailto:${company.emails[0]}`} class="hover:text-amber-500">{company.emails[0]}</a></li>
        <li class="flex gap-2.5"><Clock class="size-4 shrink-0 mt-0.5 text-amber-500" /><span>{company.hours.weekdays}<br />Saturday: {company.hours.saturday}</span></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page py-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-400">
      <p>&copy; {year} Kedar Industries. All rights reserved.</p>
      <div class="flex items-center gap-6">
        {nav.footerLegal.map((link) => (
          <a href={link.href} class="hover:text-amber-500 transition-colors">{link.label}</a>
        ))}
      </div>
    </div>
  </div>
</footer>
