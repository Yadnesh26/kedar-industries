---
interface Spec {
  label: string;
  value: string;
}
interface Props {
  specs: Spec[];
  title?: string;
}
const { specs, title = 'Technical Specification' } = Astro.props;
---

<div class="card overflow-hidden">
  {title && (
    <div class="px-5 py-4 border-b border-ink-100 bg-ink-100/50">
      <h3 class="font-display font-bold text-ink-900 text-sm">{title}</h3>
    </div>
  )}
  <table class="w-full text-sm">
    <tbody>
      {specs.map((spec, i) => (
        <tr class:list={[i % 2 === 1 && 'bg-ink-100/40']}>
          <th scope="row" class="text-left font-medium text-ink-900 px-5 py-3 w-2/5">{spec.label}</th>
          <td class="px-5 py-3 font-mono-figure text-ink-900">{spec.value}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
