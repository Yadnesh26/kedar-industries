---
import { Image, getImage } from 'astro:assets';
import { Expand, X, ChevronLeft, ChevronRight } from '@lucide/astro';
import { img } from '@/lib/images';

interface Props {
  images: string[];
  /** Unique id so multiple lightbox groups can live on one page. */
  groupId: string;
  captionPrefix?: string;
  /** Grid columns. Defaults to the multi-page report layout. */
  gridClass?: string;
}
const {
  images,
  groupId,
  captionPrefix = 'Page',
  gridClass = 'grid-cols-2 sm:grid-cols-3 md:grid-cols-4',
} = Astro.props;

const sources = images.map((file) => img(file));

// Portrait scans (report pages, letters) sit in uniform 3:4 tiles. Landscape ones
// (e.g. the C&S certificate) would be centre-cropped by that tile, so they keep
// their own aspect ratio and span two grid columns instead.
const thumbs = sources.map((src) => {
  const landscape = src.width > src.height;
  return landscape
    ? { landscape, width: 600, height: Math.round((600 / src.width) * src.height) }
    : { landscape, width: 300, height: 400 };
});

// The grid thumbnails are small (300-600px). The lightbox needs its own, far larger
// rendition — scan pages are only legible near their native resolution — and it
// must keep the source aspect ratio so landscape certificates aren't cropped.
const fullSizes = await Promise.all(
  sources.map(async (src) => {
    const width = Math.min(src.width, 1600);
    const height = Math.round((width / src.width) * src.height);
    const generated = await getImage({ src, width, height, format: 'webp', quality: 90 });
    return { src: generated.src, width, height };
  })
);
---

<div class:list={['grid gap-3', gridClass]} data-lightbox-group={groupId}>
  {images.map((_file, i) => (
    <button
      type="button"
      class:list={[
        'group relative rounded-md overflow-hidden border border-ink-100 bg-ink-100',
        thumbs[i].landscape ? 'col-span-2' : 'aspect-[3/4]',
      ]}
      style={thumbs[i].landscape ? `aspect-ratio: ${thumbs[i].width} / ${thumbs[i].height}` : undefined}
      data-lightbox-trigger
      data-index={i}
      data-full={fullSizes[i].src}
      data-full-width={fullSizes[i].width}
      data-full-height={fullSizes[i].height}
    >
      <Image
        src={sources[i]}
        alt={`${captionPrefix} ${i + 1}`}
        width={thumbs[i].width}
        height={thumbs[i].height}
        densities={[1, 2]}
        class="w-full h-full object-cover"
      />
      <span class="absolute inset-0 bg-ink-900/0 group-hover:bg-ink-900/40 transition-colors flex items-center justify-center">
        <Expand class="size-5 text-paper opacity-0 group-hover:opacity-100 transition-opacity" />
      </span>
    </button>
  ))}
</div>

<dialog
  data-lightbox-dialog={groupId}
  class="backdrop:bg-ink-900/90 bg-transparent p-0 max-w-none max-h-none w-screen h-screen m-0 open:flex items-center justify-center select-none"
>
  <div class="relative w-full h-full flex items-center justify-center p-6">
    <button
      type="button"
      data-lightbox-close
      class="absolute top-4 right-4 text-paper/80 hover:text-amber-500 p-2"
      aria-label="Close"
    >
      <X class="size-7" />
    </button>
    <button
      type="button"
      data-lightbox-prev
      class="absolute left-2 sm:left-6 text-paper/80 hover:text-amber-500 p-2"
      aria-label="Previous image"
    >
      <ChevronLeft class="size-8" />
    </button>
    <img data-lightbox-img draggable="false" class="max-h-[85vh] max-w-[90vw] object-contain rounded-md" alt="" />
    <button
      type="button"
      data-lightbox-next
      class="absolute right-2 sm:right-6 text-paper/80 hover:text-amber-500 p-2"
      aria-label="Next image"
    >
      <ChevronRight class="size-8" />
    </button>
  </div>
</dialog>

<script define:vars={{ groupId }}>
  const group = document.querySelector(`[data-lightbox-group="${groupId}"]`);
  const dialog = document.querySelector(`[data-lightbox-dialog="${groupId}"]`);
  if (group && dialog) {
    const imgEl = dialog.querySelector('[data-lightbox-img]');
    // Each trigger carries its own full-resolution rendition in data-full. Do not
    // fall back to the thumbnail's <img src> — that is a small thumbnail, and blowing
    // it up to fill the dialog is what made the scanned certificates unreadable.
    const triggers = Array.from(group.querySelectorAll('[data-lightbox-trigger]'));
    const fulls = triggers.map((btn) => ({
      src: btn.dataset.full,
      width: btn.dataset.fullWidth,
      height: btn.dataset.fullHeight,
      alt: btn.querySelector('img')?.getAttribute('alt') ?? '',
    }));
    let current = 0;

    function show(index) {
      current = (index + fulls.length) % fulls.length;
      const next = fulls[current];
      imgEl.setAttribute('src', next.src);
      imgEl.setAttribute('width', next.width);
      imgEl.setAttribute('height', next.height);
      imgEl.setAttribute('alt', next.alt);
      // Rapid arrow clicks register as double/triple clicks and select the whole
      // dialog, which paints the site's amber ::selection colour over the scan.
      window.getSelection()?.removeAllRanges();
    }

    group.querySelectorAll('[data-lightbox-trigger]').forEach((btn) => {
      btn.addEventListener('click', () => {
        show(Number(btn.dataset.index));
        dialog.showModal();
      });
    });

    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.querySelector('[data-lightbox-prev]')?.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lightbox-next]')?.addEventListener('click', () => show(current + 1));
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });
  }
</script>
