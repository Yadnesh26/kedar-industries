---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
---

<div class="product-carousel relative">
  <button
    type="button"
    class="product-carousel__arrow product-carousel__arrow--prev hidden sm:flex"
    aria-label="Previous product"
  >
    <ChevronLeft class="size-5" />
  </button>

  <div class="product-carousel__track" data-carousel-track>
    <slot />
  </div>

  <button
    type="button"
    class="product-carousel__arrow product-carousel__arrow--next hidden sm:flex"
    aria-label="Next product"
  >
    <ChevronRight class="size-5" />
  </button>
</div>

<style>
  .product-carousel__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 0.25rem;
  }
  .product-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .product-carousel__track > :global(*) {
    scroll-snap-align: start;
  }
  .product-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: var(--color-paper);
    border: 1px solid var(--color-ink-100);
    color: var(--color-ink-900);
    box-shadow: 0 8px 20px -8px rgba(14, 17, 22, 0.25);
    transition:
      border-color 200ms var(--ease-out-standard),
      color 200ms var(--ease-out-standard);
  }
  .product-carousel__arrow:hover {
    border-color: var(--color-amber-500);
    color: var(--color-amber-600);
  }
  .product-carousel__arrow--prev {
    left: -1.5rem;
  }
  .product-carousel__arrow--next {
    right: -1.5rem;
  }
</style>

<script>
  const AUTO_ADVANCE_MS = 3500;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll('.product-carousel').forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    const prevBtn = carousel.querySelector('.product-carousel__arrow--prev');
    const nextBtn = carousel.querySelector('.product-carousel__arrow--next');
    if (!track) return;

    const originalItems = Array.from(track.children);
    if (originalItems.length === 0) return;

    // Duplicate the set once so the track can be reset invisibly, giving a
    // seamless infinite loop instead of a hard snap back to the start.
    originalItems.forEach((item) => {
      const clone = item.cloneNode(true);
      clone.setAttribute('aria-hidden', 'true');
      clone.querySelectorAll('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
      track.appendChild(clone);
    });

    function oneSetWidth() {
      return track.scrollWidth / 2;
    }

    function stepWidth() {
      const item = track.querySelector(':scope > *');
      return item ? item.getBoundingClientRect().width + 24 : track.clientWidth;
    }

    function step(dir) {
      const full = oneSetWidth();
      // Snap back invisibly before animating past either duplicated edge.
      if (dir > 0 && track.scrollLeft >= full - 4) {
        track.scrollLeft -= full;
      } else if (dir < 0 && track.scrollLeft <= 4) {
        track.scrollLeft += full;
      }
      track.scrollBy({ left: stepWidth() * dir, behavior: 'smooth' });
    }

    let timer = null;
    function startAuto() {
      if (reduceMotion) return;
      stopAuto();
      timer = window.setInterval(() => step(1), AUTO_ADVANCE_MS);
    }
    function stopAuto() {
      if (timer) window.clearInterval(timer);
      timer = null;
    }

    prevBtn?.addEventListener('click', () => {
      step(-1);
      startAuto();
    });
    nextBtn?.addEventListener('click', () => {
      step(1);
      startAuto();
    });

    // Pause only on a genuine hover (the mouse actually moving while over the
    // carousel), not merely on `mouseenter` — scrolling the page down to this
    // section with the cursor held still fires `mouseenter` with no real
    // pointer movement, and if the cursor then rests inside the carousel with
    // no `mouseleave` to follow, auto-advance would otherwise stay paused
    // forever.
    let hovering = false;
    carousel.addEventListener('mousemove', () => {
      if (!hovering) {
        hovering = true;
        stopAuto();
      }
    });
    carousel.addEventListener('mouseleave', () => {
      hovering = false;
      startAuto();
    });
    carousel.addEventListener('focusin', stopAuto);
    carousel.addEventListener('focusout', (e) => {
      if (!carousel.contains(e.relatedTarget)) startAuto();
    });

    startAuto();
  });
</script>
