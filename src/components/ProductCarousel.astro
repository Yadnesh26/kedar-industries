---
import { ChevronLeft, ChevronRight } from '@lucide/astro';
---

<div class="product-carousel relative">
  <button
    type="button"
    class="product-carousel__arrow product-carousel__arrow--prev hidden sm:flex"
    aria-label="Previous product"
  >
    <ChevronLeft class="size-5" />
  </button>

  <div class="product-carousel__track" data-carousel-track>
    <slot />
  </div>

  <button
    type="button"
    class="product-carousel__arrow product-carousel__arrow--next hidden sm:flex"
    aria-label="Next product"
  >
    <ChevronRight class="size-5" />
  </button>
</div>

<style>
  .product-carousel__track {
    display: flex;
    gap: 1.5rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 1.5rem;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-block: 0.25rem;
  }
  .product-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .product-carousel__track > :global(*) {
    scroll-snap-align: start;
  }
  .product-carousel__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 10;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: var(--color-paper);
    border: 1px solid var(--color-ink-100);
    color: var(--color-ink-900);
    box-shadow: 0 8px 20px -8px rgba(14, 17, 22, 0.25);
    transition:
      border-color 200ms var(--ease-out-standard),
      color 200ms var(--ease-out-standard),
      opacity 200ms var(--ease-out-standard);
  }
  .product-carousel__arrow:hover {
    border-color: var(--color-amber-500);
    color: var(--color-amber-600);
  }
  .product-carousel__arrow--prev {
    left: -1.5rem;
  }
  .product-carousel__arrow--next {
    right: -1.5rem;
  }
  .product-carousel__arrow[disabled] {
    opacity: 0.35;
    cursor: default;
    pointer-events: none;
  }
</style>

<script>
  document.querySelectorAll('.product-carousel').forEach((carousel) => {
    const track = carousel.querySelector('[data-carousel-track]');
    const prevBtn = carousel.querySelector('.product-carousel__arrow--prev');
    const nextBtn = carousel.querySelector('.product-carousel__arrow--next');
    if (!track) return;

    function scrollByAmount(dir) {
      const item = track.querySelector(':scope > *');
      const amount = item ? item.getBoundingClientRect().width + 24 : track.clientWidth * 0.8;
      track.scrollBy({ left: amount * dir, behavior: 'smooth' });
    }

    prevBtn?.addEventListener('click', () => scrollByAmount(-1));
    nextBtn?.addEventListener('click', () => scrollByAmount(1));

    function updateArrows() {
      const max = track.scrollWidth - track.clientWidth;
      if (prevBtn) prevBtn.disabled = track.scrollLeft <= 4;
      if (nextBtn) nextBtn.disabled = track.scrollLeft >= max - 4;
    }
    track.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    updateArrows();
  });
</script>
