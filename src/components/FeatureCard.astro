---
import * as icons from '@lucide/astro';

interface Props {
  icon: keyof typeof icons;
  title: string;
  description: string;
}
const { icon, title, description } = Astro.props;
const Icon = icons[icon] as typeof icons.CircleCheck;
---

<div class="card p-6 flex flex-col gap-4">
  <div class="size-11 rounded-md bg-amber-100 flex items-center justify-center">
    <Icon class="size-5 text-amber-600" />
  </div>
  <div>
    <h3 class="font-display font-bold text-ink-900 text-base mb-1.5">{title}</h3>
    <p class="text-sm text-ink-400 leading-relaxed">{description}</p>
  </div>
</div>
