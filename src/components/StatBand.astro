---
interface Stat {
  value: string;
  numericValue?: number;
  suffix?: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

{/*
  A floating card overlapping the hero's bottom edge, matching the
  reference site's stat-band treatment — pulled up with a negative
  margin so it straddles the hero/white-section boundary instead of
  sitting as a plain full-width bar.
*/}
<div class="relative z-10 container-page -mt-12 sm:-mt-16">
  <div class="stat-card relative rounded-2xl bg-ink-900 shadow-2xl shadow-ink-900/40 border border-white/10 overflow-hidden">
    {/*
      A fine field of drifting embers — modelled on how antigravity.google
      actually does it (inspected in a real browser): very small, dense,
      low-contrast specks with slow motion and NO connecting lines. Here
      they rise like sparks off a shop floor, which suits an electrical
      manufacturer rather than being a generic tech-site effect.
      Scoped to this card only.
    */}
    <div class="stat-card__heat" aria-hidden="true"></div>
    <canvas class="stat-card__canvas" aria-hidden="true"></canvas>

    <dl class="relative grid grid-cols-2 md:grid-cols-4 gap-8 px-6 py-8 sm:px-10 sm:py-10">
      {stats.map((stat) => (
        <div class="text-center md:text-left">
          <dt class="sr-only">{stat.label}</dt>
          <dd
            class="font-mono-figure text-3xl sm:text-4xl text-amber-500 font-semibold"
            data-stat
            data-target={stat.numericValue ?? ''}
            data-suffix={stat.suffix ?? ''}
          >
            {stat.value}
          </dd>
          <p class="mt-1 text-sm text-ink-400">{stat.label}</p>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
  /* Scoped to this component by Astro — cannot leak to any other card. */

  /* A faint warm wash along the bottom edge, so the embers read as rising
     off a heat source rather than floating in an empty box. */
  .stat-card__heat {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(90% 120% at 18% 118%, rgba(255, 198, 60, 0.16) 0%, transparent 62%),
      radial-gradient(70% 110% at 82% 122%, rgba(255, 160, 40, 0.1) 0%, transparent 60%);
    pointer-events: none;
  }

  .stat-card__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .stat-card__canvas {
      display: none;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Count-up ------------------------------------------------------
  if (!prefersReducedMotion) {
    const els = document.querySelectorAll<HTMLElement>('[data-stat][data-target]');
    const countObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.target);
          const suffix = el.dataset.suffix ?? '';
          if (!target) continue;
          const duration = 1200;
          const start = performance.now();
          function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(target * eased).toLocaleString('en-IN') + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
          countObserver.unobserve(el);
        }
      },
      { threshold: 0.4 }
    );
    els.forEach((el) => countObserver.observe(el));
  }

  // ---- Ember field ---------------------------------------------------
  if (!prefersReducedMotion) {
    document.querySelectorAll<HTMLElement>('.stat-card').forEach((card) => {
      const canvas = card.querySelector<HTMLCanvasElement>('.stat-card__canvas');
      if (!canvas) return;
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      type Ember = {
        x: number;
        y: number;
        size: number;
        speed: number;
        drift: number;
        phase: number;
        alpha: number;
        warm: boolean;
        glow: boolean;
      };

      let embers: Ember[] = [];
      let w = 0;
      let h = 0;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      let running = false;
      let rafId = 0;

      function makeEmber(randomY: boolean): Ember {
        const glow = Math.random() < 0.06; // a handful of brighter sparks
        return {
          x: Math.random() * w,
          y: randomY ? Math.random() * h : h + Math.random() * 20,
          // Deliberately tiny — the reference's specks are ~1px, not orbs
          size: glow ? Math.random() * 1.2 + 1.1 : Math.random() * 0.8 + 0.4,
          speed: (Math.random() * 0.22 + 0.08) * (glow ? 0.65 : 1),
          drift: Math.random() * 0.22 + 0.05,
          phase: Math.random() * Math.PI * 2,
          alpha: glow ? Math.random() * 0.35 + 0.55 : Math.random() * 0.45 + 0.28,
          warm: Math.random() < 0.72, // amber vs. near-white, for depth
          glow,
        };
      }

      function resize() {
        const rect = card.getBoundingClientRect();
        w = rect.width;
        h = rect.height;
        canvas!.width = Math.round(w * dpr);
        canvas!.height = Math.round(h * dpr);
        ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Dense but fine, scaled to the card's area
        const count = Math.round(Math.min(Math.max((w * h) / 1100, 160), 420));
        embers = Array.from({ length: count }, () => makeEmber(true));
      }

      let t = 0;
      function frame() {
        if (!running) return;
        t += 0.016;
        ctx!.clearRect(0, 0, w, h);

        for (let i = 0; i < embers.length; i++) {
          const e = embers[i];

          // Rise, with a slow sideways sway so it reads as air movement
          e.y -= e.speed;
          e.x += Math.sin(t * 0.6 + e.phase) * e.drift * 0.35;

          if (e.y < -4) embers[i] = makeEmber(false);
          if (e.x < -4) e.x = w + 4;
          if (e.x > w + 4) e.x = -4;

          // Fade in at the bottom and out at the top so nothing pops
          const edgeFade = Math.min(1, Math.min(e.y / (h * 0.3), (h - e.y) / (h * 0.25), 1));
          const twinkle = 0.75 + Math.sin(t * 1.6 + e.phase) * 0.25;
          const a = e.alpha * Math.max(0, edgeFade) * twinkle;
          if (a <= 0.01) continue;

          const rgb = e.warm ? '255, 198, 60' : '255, 241, 214';

          if (e.glow) {
            ctx!.shadowColor = `rgba(${rgb}, ${a * 0.9})`;
            ctx!.shadowBlur = 8;
          }
          ctx!.fillStyle = `rgba(${rgb}, ${a})`;
          ctx!.beginPath();
          ctx!.arc(e.x, e.y, e.size, 0, Math.PI * 2);
          ctx!.fill();
          if (e.glow) ctx!.shadowBlur = 0;
        }

        rafId = requestAnimationFrame(frame);
      }

      function start() {
        if (running) return;
        running = true;
        rafId = requestAnimationFrame(frame);
      }
      function stop() {
        running = false;
        cancelAnimationFrame(rafId);
      }

      resize();
      new ResizeObserver(() => resize()).observe(card);

      // Only animate while the card is actually on screen and the tab is active.
      const vis = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting && document.visibilityState === 'visible') start();
          else stop();
        },
        { threshold: 0.01 }
      );
      vis.observe(card);
      document.addEventListener('visibilitychange', () => {
        if (document.visibilityState === 'visible') {
          const r = card.getBoundingClientRect();
          if (r.bottom > 0 && r.top < window.innerHeight) start();
        } else stop();
      });
    });
  }
</script>
