---
interface Stat {
  value: string;
  numericValue?: number;
  suffix?: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

{/*
  A floating plate overlapping the hero's bottom edge — pulled up with a
  negative margin so it straddles the hero/white-section boundary.

  Styled like the rating plate riveted to a switchgear enclosure rather
  than a generic rounded stat card: a keyed chamfer cuts the top-left and
  bottom-right corners (echoing the diagonal-edge sections used elsewhere
  on this page), with a rivet mark in each of the two square corners.
  Each figure gets its own short amber witness mark in place of a full
  divider — a dimension-line leader, not a card border.
*/}
<div class="relative z-10 container-page -mt-12 sm:-mt-16">
  <div class="stat-plate">
    <div class="stat-plate__fill">
      <span class="stat-plate__rivet stat-plate__rivet--tr" aria-hidden="true"></span>
      <span class="stat-plate__rivet stat-plate__rivet--bl" aria-hidden="true"></span>
      <dl class="stat-plate__grid grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-9 px-6 py-10 sm:px-10 sm:py-12">
        {stats.map((stat) => (
          <div class="stat-plate__item">
            <dt class="sr-only">{stat.label}</dt>
            <dd
              class="font-mono-figure text-3xl sm:text-4xl text-amber-500 font-semibold"
              data-stat
              data-target={stat.numericValue ?? ''}
              data-suffix={stat.suffix ?? ''}
            >
              {stat.value}
            </dd>
            <span class="stat-plate__tick" aria-hidden="true"></span>
            <p class="text-sm text-ink-200">{stat.label}</p>
          </div>
        ))}
      </dl>
    </div>
  </div>
</div>

<style>
  /* Two stacked, identically-clipped layers stand in for a border: clip-path
     cuts off any border stroke along the diagonal edge, so a 1px inset of
     the fill color (--color-ink-900) over a lighter outer layer paints the
     chamfer's "stroke" instead. */
  .stat-plate {
    --chamfer: 18px;
    padding: 1px;
    background: rgba(255, 255, 255, 0.16);
    clip-path: polygon(
      var(--chamfer) 0,
      100% 0,
      100% calc(100% - var(--chamfer)),
      calc(100% - var(--chamfer)) 100%,
      0 100%,
      0 var(--chamfer)
    );
  }
  @media (min-width: 640px) {
    .stat-plate {
      --chamfer: 26px;
    }
  }

  .stat-plate__fill {
    position: relative;
    background: var(--color-ink-900);
    clip-path: polygon(
      calc(var(--chamfer) - 1px) 0,
      100% 0,
      100% calc(100% - (var(--chamfer) - 1px)),
      calc(100% - (var(--chamfer) - 1px)) 100%,
      0 100%,
      0 calc(var(--chamfer) - 1px)
    );
  }

  .stat-plate__rivet {
    position: absolute;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(255, 204, 42, 0.4);
    box-shadow: 0 0 0 1px rgba(255, 204, 42, 0.18);
  }
  .stat-plate__rivet--tr {
    top: 12px;
    right: 12px;
  }
  .stat-plate__rivet--bl {
    bottom: 12px;
    left: 12px;
  }

  .stat-plate__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  /* The witness mark under each figure — a short leader line rather than a
     full-height rule between columns. */
  .stat-plate__tick {
    display: block;
    width: 20px;
    height: 2px;
    margin: 10px 0 8px;
    background: var(--color-amber-500);
    opacity: 0.55;
  }
</style>

<script>
  // Count up from 0 to the real value already rendered server-side, so the
  // page never shows an unstyled "0+" before JS loads. Skipped entirely
  // for prefers-reduced-motion.
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!prefersReducedMotion) {
    const els = document.querySelectorAll<HTMLElement>('[data-stat][data-target]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.target);
          const suffix = el.dataset.suffix ?? '';
          if (!target) continue;
          const duration = 1200;
          const start = performance.now();
          function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(target * eased).toLocaleString('en-IN') + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
          observer.unobserve(el);
        }
      },
      { threshold: 0.4 }
    );
    els.forEach((el) => observer.observe(el));
  }
</script>
