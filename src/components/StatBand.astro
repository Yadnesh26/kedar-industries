---
interface Stat {
  value: string;
  numericValue?: number;
  suffix?: string;
  label: string;
}
interface Props {
  stats: Stat[];
}
const { stats } = Astro.props;
---

{/*
  A floating card overlapping the hero's bottom edge, matching the
  reference site's stat-band treatment — pulled up with a negative
  margin so it straddles the hero/white-section boundary instead of
  sitting as a plain full-width bar.
*/}
<div class="relative z-10 container-page -mt-12 sm:-mt-16">
  <div class="stat-card relative rounded-2xl bg-ink-900 shadow-2xl shadow-ink-900/40 border border-white/10 overflow-hidden">
    {/*
      Three-phase AC waveform, drawn live: three sine waves 120° apart in
      the R / Y / B phase colours, over a faint oscilloscope graticule.
      This is literally what Kedar's panels distribute — 415 V, 3-phase,
      50 Hz — and the R/Y/B phases are the same ones named throughout
      their CPRI test reports. Scoped to this card only.
    */}
    <div class="stat-card__grid" aria-hidden="true"></div>
    <canvas class="stat-card__scope" aria-hidden="true"></canvas>
    <div class="stat-card__scrim" aria-hidden="true"></div>

    <dl class="relative grid grid-cols-2 md:grid-cols-4 gap-8 px-6 py-8 sm:px-10 sm:py-10">
      {stats.map((stat) => (
        <div class="text-center md:text-left">
          <dt class="sr-only">{stat.label}</dt>
          <dd
            class="font-mono-figure text-3xl sm:text-4xl text-amber-500 font-semibold"
            data-stat
            data-target={stat.numericValue ?? ''}
            data-suffix={stat.suffix ?? ''}
          >
            {stat.value}
          </dd>
          <p class="mt-1 text-sm text-ink-400">{stat.label}</p>
        </div>
      ))}
    </dl>
  </div>
</div>

<style>
  /* Scoped to this component by Astro — cannot leak to any other card. */

  /* Oscilloscope graticule: the measurement grid the waveform sits on,
     echoing the CPRI test-report theme. Deliberately very faint. */
  .stat-card__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(130% 110% at 50% 50%, #000 35%, transparent 85%);
    pointer-events: none;
  }

  .stat-card__scope {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    pointer-events: none;
  }

  /* Knocks the traces back through the horizontal band where the figures
     sit, so the waveform stays vivid top and bottom but never fights the
     text for legibility. */
  .stat-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(14, 17, 22, 0.55) 40%,
      rgba(14, 17, 22, 0.55) 62%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* No motion: keep a single static waveform frame (drawn by the script)
     so the card still reads as intentional, just without animation. */
  @media (prefers-reduced-motion: reduce) {
    .stat-card__scope {
      opacity: 0.7;
    }
  }
</style>

<script>
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ---- Count-up ------------------------------------------------------
  if (!prefersReducedMotion) {
    const els = document.querySelectorAll<HTMLElement>('[data-stat][data-target]');
    const countObserver = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const el = entry.target as HTMLElement;
          const target = Number(el.dataset.target);
          const suffix = el.dataset.suffix ?? '';
          if (!target) continue;
          const duration = 1200;
          const start = performance.now();
          function tick(now: number) {
            const progress = Math.min((now - start) / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            el.textContent = Math.round(target * eased).toLocaleString('en-IN') + suffix;
            if (progress < 1) requestAnimationFrame(tick);
          }
          requestAnimationFrame(tick);
          countObserver.unobserve(el);
        }
      },
      { threshold: 0.4 }
    );
    els.forEach((el) => countObserver.observe(el));
  }

  // ---- Three-phase waveform -----------------------------------------
  document.querySelectorAll<HTMLElement>('.stat-card').forEach((card) => {
    const canvas = card.querySelector<HTMLCanvasElement>('.stat-card__scope');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // R / Y / B — the three phases, in the order they appear in the CPRI
    // reports (Ir, Iy, Ib). Yellow doubles as the brand amber.
    const PHASES = [
      { rgb: '236, 50, 55', shift: 0 }, // R
      { rgb: '255, 198, 60', shift: (Math.PI * 2) / 3 }, // Y
      { rgb: '0, 168, 90', shift: (Math.PI * 4) / 3 }, // B (brand green)
    ];

    let w = 0;
    let h = 0;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let running = false;
    let rafId = 0;
    let t = 0;

    function resize() {
      const rect = card.getBoundingClientRect();
      w = rect.width;
      h = rect.height;
      canvas!.width = Math.round(w * dpr);
      canvas!.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      if (!running) draw(); // keep a frame on screen when paused
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);

      const mid = h * 0.5;
      // Deliberately large: the traces should arc well above and below the
      // text band, so the waveform still reads clearly on a short card.
      const amp = h * 0.42;
      // Two full cycles across the card, so it reads as a waveform rather
      // than a single lazy curve.
      const k = (Math.PI * 4) / w;
      const step = 3;

      for (const phase of PHASES) {
        ctx!.beginPath();
        for (let x = 0; x <= w; x += step) {
          // Slight amplitude taper at the edges so the trace fades out
          // instead of being cut off by the card border.
          const edge = Math.min(1, Math.min(x, w - x) / (w * 0.12));
          const y = mid + Math.sin(x * k - t + phase.shift) * amp * edge;
          if (x === 0) ctx!.moveTo(x, y);
          else ctx!.lineTo(x, y);
        }
        ctx!.strokeStyle = `rgba(${phase.rgb}, 0.5)`;
        ctx!.lineWidth = 1.6;
        ctx!.shadowColor = `rgba(${phase.rgb}, 0.55)`;
        ctx!.shadowBlur = 10;
        ctx!.stroke();
        ctx!.shadowBlur = 0;
      }

      // A brighter "sampling head" travelling along each trace — the point
      // a meter would be reading, tying back to the type-testing story.
      const headX = ((t * 0.16) % (Math.PI * 2)) / (Math.PI * 2) * w;
      for (const phase of PHASES) {
        const edge = Math.min(1, Math.min(headX, w - headX) / (w * 0.12));
        const y = mid + Math.sin(headX * k - t + phase.shift) * amp * edge;
        ctx!.beginPath();
        ctx!.fillStyle = `rgba(${phase.rgb}, 0.95)`;
        ctx!.shadowColor = `rgba(${phase.rgb}, 0.9)`;
        ctx!.shadowBlur = 12;
        ctx!.arc(headX, y, 2.4, 0, Math.PI * 2);
        ctx!.fill();
        ctx!.shadowBlur = 0;
      }
    }

    function frame() {
      if (!running) return;
      t += 0.022; // ~ a slow, readable 50 Hz stand-in
      draw();
      rafId = requestAnimationFrame(frame);
    }

    function start() {
      if (running || prefersReducedMotion) return;
      running = true;
      rafId = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(rafId);
    }

    resize();
    draw();
    new ResizeObserver(() => resize()).observe(card);

    const vis = new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting && document.visibilityState === 'visible') start();
        else stop();
      },
      { threshold: 0.01 }
    );
    vis.observe(card);
    document.addEventListener('visibilitychange', () => {
      if (document.visibilityState === 'visible') {
        const r = card.getBoundingClientRect();
        if (r.bottom > 0 && r.top < window.innerHeight) start();
      } else stop();
    });
  });
</script>
