---
import { ArrowRight, Phone } from '@lucide/astro';
import company from '@/data/company.json';

interface Props {
  title?: string;
  lead?: string;
  showCall?: boolean;
}
const {
  title = 'Need a type-tested panel built to your spec?',
  lead = 'Send us your load requirement or single-line diagram and our engineering team will respond with a costed proposal.',
  showCall = true,
} = Astro.props;
---

<section class="section-y section-diagonal-dark">
  <div class="section-diagonal-dark__edges" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <div class="container-page relative text-center">
    <div class="max-w-3xl mx-auto">
      <h2 class="text-paper leading-tight text-2xl sm:text-[1.75rem] text-balance">
        {title}
      </h2>
      <p class="mt-4 text-base sm:text-lg text-ink-200 max-w-2xl mx-auto">{lead}</p>
      <div class="mt-8 flex flex-col sm:flex-row sm:flex-wrap items-stretch sm:items-center justify-center gap-3 sm:gap-4">
        <a href="/contact/" class="btn btn-primary justify-center">
          Get a Quote <ArrowRight class="size-4" />
        </a>
        {showCall && (
          <a href={`tel:${company.phoneHref}`} class="btn btn-outline-dark justify-center">
            <Phone class="size-4" /> Call {company.phone}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
