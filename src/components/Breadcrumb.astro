---
import { ChevronRight } from '@lucide/astro';

interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: Crumb[];
}
const { items } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.label,
    ...(item.href ? { item: new URL(item.href, Astro.site).toString() } : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
<nav aria-label="Breadcrumb" class="breadcrumb-stepped">
  <ol class="container-page flex items-center gap-2 py-4 text-sm text-ink-200 flex-wrap">
    {items.map((item, i) => (
      <li class="flex items-center gap-2">
        {i > 0 && <ChevronRight class="size-3.5 text-white/25" />}
        {item.href ? (
          <a href={item.href} class="hover:text-amber-500 transition-colors">{item.label}</a>
        ) : (
          <span class="text-paper font-medium">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  /* Flat posterized bands instead of a smooth gradient or a diagonal cut:
     the bar steps up in solid opacity blocks (30% -> 65% -> 100%) toward
     the middle and back down toward each end, so the edges read as
     stepped without borrowing the diagonal-slant shape used on the
     larger dark sections elsewhere on the site. */
  .breadcrumb-stepped {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-ink-900) 30%, transparent) 0%,
      color-mix(in srgb, var(--color-ink-900) 30%, transparent) 4%,
      color-mix(in srgb, var(--color-ink-900) 65%, transparent) 4%,
      color-mix(in srgb, var(--color-ink-900) 65%, transparent) 8%,
      var(--color-ink-900) 8%,
      var(--color-ink-900) 92%,
      color-mix(in srgb, var(--color-ink-900) 65%, transparent) 92%,
      color-mix(in srgb, var(--color-ink-900) 65%, transparent) 96%,
      color-mix(in srgb, var(--color-ink-900) 30%, transparent) 96%,
      color-mix(in srgb, var(--color-ink-900) 30%, transparent) 100%
    );
  }
</style>
