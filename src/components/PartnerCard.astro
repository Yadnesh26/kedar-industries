---
import { Image } from 'astro:assets';
import { ShieldCheck } from '@lucide/astro';
import { img, hasImg } from '@/lib/images';

interface Props {
  partner: string;
  role: string;
  scope: string;
  validTill?: string | null;
  logo?: string;
}
const { partner, role, scope, validTill, logo } = Astro.props;

const isSvg = logo?.endsWith('.svg');
const hasRasterLogo = Boolean(logo && !isSvg && hasImg(logo));
const shortLabel = partner.split(' ')[0].replace(/[.,]+$/, '');
---

<div class="card overflow-hidden">
  <div class="grid sm:grid-cols-[13rem_1fr]">
    <div class="flex items-center justify-center bg-ink-100/60 p-8">
      {isSvg ? (
        <img src={`/logos/${logo}`} alt={partner} width="120" height="98" class="max-h-16 sm:max-h-20 w-auto object-contain" />
      ) : hasRasterLogo ? (
        <Image
          src={img(logo!)}
          alt={partner}
          width={160}
          height={160}
          fit="contain"
          class="max-h-16 sm:max-h-20 max-w-full w-auto h-auto object-contain"
        />
      ) : (
        <span class="flex items-center justify-center h-11 px-4 rounded-md bg-ink-900 text-paper font-display font-bold text-sm tracking-wide">
          {shortLabel}
        </span>
      )}
    </div>

    <div class="p-6 sm:p-8 flex flex-col">
      <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2">
        <div>
          <h3 class="font-display font-bold text-ink-900 text-lg leading-tight">{partner}</h3>
          <p class="text-sm text-amber-600 font-medium mt-0.5">{role}</p>
        </div>
        <span class="flex items-center gap-1.5 text-xs font-mono-figure text-amber-600 bg-amber-100 px-2.5 py-1 rounded-full shrink-0">
          <ShieldCheck class="size-3.5" /> Authorised
        </span>
      </div>
      <p class="text-sm text-ink-400 leading-relaxed mt-4 flex-1">{scope}</p>
      <p class="text-xs text-ink-400 font-mono-figure mt-5 pt-4 border-t border-ink-100">
        {validTill ? `Valid till ${validTill}` : 'Ongoing partnership'}
      </p>
    </div>
  </div>
</div>
