---
interface Milestone {
  period: string;
  title: string;
  description: string;
}
interface Props {
  milestones: Milestone[];
}
const { milestones } = Astro.props;
---

<ol class="relative border-l-2 border-ink-100 ml-3 flex flex-col gap-10">
  {milestones.map((m) => (
    <li class="relative pl-8">
      <span class="absolute -left-[9px] top-1 size-4 rounded-full bg-amber-500 border-4 border-paper ring-1 ring-ink-100"></span>
      <p class="eyebrow mb-1">{m.period}</p>
      <h3 class="font-display font-bold text-ink-900 text-lg mb-1">{m.title}</h3>
      <p class="text-sm text-ink-400 leading-relaxed max-w-xl">{m.description}</p>
    </li>
  ))}
</ol>
