---
import { Image } from 'astro:assets';
import { ArrowUpRight } from '@lucide/astro';
import { img } from '@/lib/images';

interface Props {
  href: string;
  name: string;
  tagline: string;
  heroImage: string;
}
const { href, name, tagline, heroImage } = Astro.props;
---

<a href={href} class="card group flex flex-col overflow-hidden">
  <div class="aspect-[4/3] overflow-hidden bg-ink-100 p-6 flex items-center justify-center">
    <Image
      src={img(heroImage)}
      alt={name}
      width={480}
      height={360}
      class="max-w-full max-h-full w-auto h-auto object-contain transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="p-5 flex flex-col gap-2 flex-1">
    <h3 class="font-display font-bold text-lg text-ink-900 flex items-start justify-between gap-2">
      {name}
      <ArrowUpRight class="size-4 shrink-0 mt-1 text-ink-200 group-hover:text-amber-500 transition-colors" />
    </h3>
    <p class="text-sm text-ink-400 leading-relaxed">{tagline}</p>
  </div>
</a>
