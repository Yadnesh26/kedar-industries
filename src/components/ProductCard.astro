---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import { img } from '@/lib/images';

interface Props {
  href: string;
  name: string;
  tagline: string;
  heroImage: string;
}
const { href, name, tagline, heroImage } = Astro.props;
---

<a href={href} class="product-card card group flex flex-col overflow-hidden h-[30rem] sm:h-[32rem] lg:h-[44rem] xl:h-[38rem] 2xl:h-[32rem]">
  <div class="flex-[3] min-h-0 p-8 flex items-center justify-center bg-ink-100/40">
    <Image
      src={img(heroImage)}
      alt={name}
      width={480}
      height={360}
      fit="contain"
      class="max-w-full max-h-full w-auto h-auto object-contain transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="flex-[2] min-h-0 p-6 flex flex-col items-center text-center gap-2">
    <h3 class="font-display font-extrabold text-xl text-ink-900 leading-tight">{name}</h3>
    <p class="text-sm text-ink-400 leading-relaxed">{tagline}</p>
    <span class="mt-auto inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-amber-500 text-ink-900 font-semibold text-sm transition-colors group-hover:bg-amber-600">
      View Details <ArrowRight class="size-4" />
    </span>
  </div>
</a>

<style>
  .product-card {
    border-color: transparent;
    box-shadow: 0 1px 4px rgba(14, 17, 22, 0.08);
    transition:
      transform 300ms var(--ease-out-standard),
      box-shadow 300ms var(--ease-out-standard),
      border-color 300ms var(--ease-out-standard);
  }
  a.product-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-amber-500);
    box-shadow:
      0 22px 40px -14px rgba(245, 158, 11, 0.45),
      0 10px 20px -8px rgba(14, 17, 22, 0.15);
  }
</style>
