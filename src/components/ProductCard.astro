---
import { Image } from 'astro:assets';
import { ArrowRight } from '@lucide/astro';
import { img } from '@/lib/images';

interface Props {
  href: string;
  name: string;
  tagline: string;
  heroImage: string;
}
const { href, name, tagline, heroImage } = Astro.props;
---

<a href={href} class="product-card card group flex flex-col overflow-hidden h-full">
  <div class="aspect-[4/3] p-8 flex items-center justify-center">
    <Image
      src={img(heroImage)}
      alt={name}
      width={480}
      height={360}
      class="max-w-full max-h-full w-auto h-auto object-contain transition-transform duration-300 group-hover:scale-105"
    />
  </div>
  <div class="p-6 flex flex-col items-center text-center gap-2 flex-1">
    <h3 class="font-display font-bold text-lg text-ink-900">{name}</h3>
    <p class="text-sm text-ink-400 leading-relaxed flex-1">{tagline}</p>
    <span class="mt-3 inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-amber-500 text-ink-900 font-semibold text-sm transition-colors group-hover:bg-amber-600">
      View Details <ArrowRight class="size-4" />
    </span>
  </div>
</a>

<style>
  .product-card {
    border-color: transparent;
    box-shadow: 0 1px 4px rgba(14, 17, 22, 0.08);
  }
</style>
