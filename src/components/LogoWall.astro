---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

interface Logo {
  name: string;
  file: string;
}
interface Props {
  logos: Logo[];
}
const { logos } = Astro.props;
const track = [...logos, ...logos];
---

<div class="logo-marquee overflow-hidden">
  <div class="logo-marquee__track flex items-center w-max">
    {track.map((logo) => (
      <div class="flex items-center justify-center shrink-0 h-20 w-40 sm:h-24 sm:w-48 px-5" title={logo.name}>
        <Image
          src={img(logo.file)}
          alt={logo.name}
          width={160}
          height={70}
          class="max-h-full max-w-full w-auto h-auto object-contain"
        />
      </div>
    ))}
  </div>
</div>

<style>
  .logo-marquee__track {
    animation: logo-marquee 32s linear infinite;
  }
  .logo-marquee:hover .logo-marquee__track {
    animation-play-state: paused;
  }
  @keyframes logo-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-marquee__track {
      animation: none;
    }
  }
</style>
