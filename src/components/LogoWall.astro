---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

interface Logo {
  name: string;
  file: string;
}
interface Props {
  logos: Logo[];
}
const { logos } = Astro.props;
---

<div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
  {logos.map((logo) => (
    <div
      class="flex items-center justify-center p-5 rounded-md border border-ink-100 bg-paper h-24 grayscale hover:grayscale-0 transition-all duration-300"
      title={logo.name}
    >
      <Image
        src={img(logo.file)}
        alt={logo.name}
        width={140}
        height={60}
        class="max-h-12 w-auto object-contain"
      />
    </div>
  ))}
</div>
