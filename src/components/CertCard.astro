---
import { BadgeCheck } from '@lucide/astro';

interface Props {
  name: string;
  number: string;
  body: string;
}
const { name, number, body } = Astro.props;
---

<div class="card p-5 flex gap-4 items-start">
  <BadgeCheck class="size-6 text-signal-green shrink-0 mt-0.5" />
  <div>
    <h3 class="font-display font-bold text-ink-900 text-sm leading-snug">{name}</h3>
    <p class="text-xs text-ink-400 mt-1.5 font-mono-figure">Cert. No. {number}</p>
    <p class="text-xs text-ink-400">{body}</p>
  </div>
</div>
