---
import { Phone, Menu, X, ChevronDown } from '@lucide/astro';
import company from '@/data/company.json';
import nav from '@/data/nav.json';
import { img } from '@/lib/images';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

const logo = img('logo-wordmark.png');
const currentPath = Astro.url.pathname;

const products = (await getCollection('products')).sort((a, b) => a.data.order - b.data.order);
const parts = (await getCollection('parts')).sort((a, b) => a.data.order - b.data.order);
---

<header class="sticky top-0 z-50 bg-paper/95 backdrop-blur border-b border-ink-100">
  <div class="container-page flex items-center justify-between h-20 gap-6">
    <a href="/" class="flex items-center shrink-0">
      <Image src={logo} alt="Kedar Industries" width={220} height={68} class="h-11 sm:h-12 w-auto object-contain" />
    </a>

    <nav aria-label="Primary" class="hidden lg:flex items-center gap-1">
      {nav.main.map((item) => (
        item.label === 'Products' ? (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors',
                currentPath.startsWith('/products/') ? 'text-amber-600' : 'text-ink-600 hover:text-amber-600',
              ]}
            >
              {item.label}
              <ChevronDown class="size-3.5 transition-transform group-hover:rotate-180" />
            </a>
            <div class="absolute left-1/2 -translate-x-1/2 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-150 z-50">
              <div class="w-[560px] bg-paper border border-ink-100 rounded-md shadow-xl p-5 grid grid-cols-2 gap-x-8 gap-y-1">
                <div>
                  <p class="eyebrow mb-2 px-2">Electrical Panels</p>
                  {products.map((p) => (
                    <a href={`/products/${p.id}/`} class="block px-2 py-1.5 rounded text-sm text-ink-600 hover:text-amber-600 hover:bg-ink-100/60 transition-colors">
                      {p.data.name}
                    </a>
                  ))}
                </div>
                <div>
                  <p class="eyebrow mb-2 px-2">Capacitor Parts</p>
                  {parts.map((p) => (
                    <a href={`/capacitor-parts/${p.id}/`} class="block px-2 py-1.5 rounded text-sm text-ink-600 hover:text-amber-600 hover:bg-ink-100/60 transition-colors">
                      {p.data.name}
                    </a>
                  ))}
                  <a href="/products/" class="block mt-2 px-2 py-1.5 rounded text-sm font-semibold text-amber-600 hover:bg-ink-100/60 transition-colors">
                    View all products →
                  </a>
                </div>
              </div>
            </div>
          </div>
        ) : item.children ? (
          <div class="relative group">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-md transition-colors',
                currentPath.startsWith('/about/') ? 'text-amber-600' : 'text-ink-600 hover:text-amber-600',
              ]}
              aria-haspopup="true"
            >
              {item.label}
              <ChevronDown class="size-3.5 transition-transform group-hover:rotate-180" />
            </a>
            <div
              class="absolute left-0 top-full pt-2 opacity-0 invisible translate-y-1 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-150"
            >
              <div class="w-64 bg-paper border border-ink-100 rounded-md shadow-xl py-2">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class="block px-4 py-2.5 text-sm text-ink-600 hover:text-amber-600 hover:bg-ink-100/60 transition-colors"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        ) : (
          <a
            href={item.href}
            class:list={[
              'px-3 py-2 text-sm font-medium rounded-md transition-colors',
              currentPath === item.href
                ? 'text-amber-600'
                : 'text-ink-600 hover:text-amber-600',
            ]}
          >
            {item.label}
          </a>
        )
      ))}
    </nav>

    <div class="hidden lg:flex items-center gap-4 shrink-0">
      <a
        href={`tel:${company.phoneHref}`}
        class="flex items-center gap-2 text-sm text-ink-600 hover:text-amber-600 transition-colors font-mono-figure"
      >
        <Phone class="size-4" />
        {company.phone}
      </a>
      <a href="/contact/" class="btn btn-primary">Get a Quote</a>
    </div>

    <button
      id="mobile-menu-toggle"
      class="lg:hidden text-ink-900 p-2 -mr-2"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Menu class="size-6" id="menu-icon-open" />
      <X class="size-6 hidden" id="menu-icon-close" />
    </button>
  </div>

  <div id="mobile-menu" class="lg:hidden hidden border-t border-ink-100 bg-paper max-h-[calc(100vh-5rem)] overflow-y-auto">
    <nav aria-label="Mobile" class="container-page py-4 flex flex-col gap-1">
      {nav.main.map((item) =>
        item.label === 'Products' ? (
          <details>
            <summary class="px-2 py-2.5 text-ink-900 font-medium cursor-pointer list-none flex items-center justify-between">
              {item.label} <ChevronDown class="size-4" />
            </summary>
            <div class="pl-4 flex flex-col gap-1 mb-1">
              {products.map((p) => (
                <a href={`/products/${p.id}/`} class="px-2 py-1.5 text-sm text-ink-400 hover:text-amber-600">{p.data.name}</a>
              ))}
              {parts.map((p) => (
                <a href={`/capacitor-parts/${p.id}/`} class="px-2 py-1.5 text-sm text-ink-400 hover:text-amber-600">{p.data.name}</a>
              ))}
            </div>
          </details>
        ) : item.children ? (
          <details>
            <summary class="px-2 py-2.5 text-ink-900 font-medium cursor-pointer list-none flex items-center justify-between">
              {item.label} <ChevronDown class="size-4" />
            </summary>
            <div class="pl-4 flex flex-col gap-1 mb-1">
              {item.children.map((child) => (
                <a href={child.href} class="px-2 py-2 text-sm text-ink-400 hover:text-amber-600">{child.label}</a>
              ))}
            </div>
          </details>
        ) : (
          <a href={item.href} class="px-2 py-2.5 text-ink-900 hover:text-amber-600 font-medium">
            {item.label}
          </a>
        )
      )}
      <a href={`tel:${company.phoneHref}`} class="px-2 py-2.5 text-ink-600 font-mono-figure">
        {company.phone}
      </a>
      <a href="/contact/" class="btn btn-primary mt-2 justify-center">Get a Quote</a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    menu?.classList.toggle('hidden');
    iconOpen?.classList.toggle('hidden');
    iconClose?.classList.toggle('hidden');
  });
</script>
