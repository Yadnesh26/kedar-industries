---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

interface CollageItem {
  src: string;
  name: string;
}
interface Slide {
  /** Photo filename (not needed for a collage slide). */
  src?: string;
  alt: string;
  /** Optional caption shown on the slide. */
  label?: string;
  /** 'contain' shows the whole photo on white (product shots); default fills the frame. */
  fit?: 'cover' | 'contain';
  /** Product cards laid out as a catalogue collage instead of a single photo. */
  collage?: CollageItem[];
}
interface Props {
  slides: Slide[];
  interval?: number;
  label?: string;
  /** Thin light border around the frame (on by default; turn off on dark sections). */
  bordered?: boolean;
  /** From lg up, stretch to the height of the parent instead of a fixed aspect ratio. */
  fill?: boolean;
  /** Show the dot navigation and its bottom gradient (on by default). */
  controls?: boolean;
  /** Crossfade length in ms. */
  fadeMs?: number;
  /** Aspect-ratio utility for the frame. */
  aspect?: string;
  /** Pause while hovered or focused (on by default). Off keeps a fixed rhythm. */
  pauseOnHover?: boolean;
  class?: string;
}
const {
  slides,
  interval = 4500,
  label = 'Photo slideshow',
  bordered = true,
  fill = false,
  controls = true,
  fadeMs = 900,
  aspect = 'aspect-[1.5686]',
  pauseOnHover = true,
  class: className,
} = Astro.props;
---

<div
  class:list={['slideshow relative rounded-2xl overflow-hidden shadow-sm bg-ink-100', aspect, fill && 'lg:aspect-auto lg:h-full lg:min-h-[24rem]', bordered && 'border border-ink-100', slides[0]?.collage && 'on-light', className]}
  style={`--fade: ${fadeMs}ms`}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-interval={interval}
  data-pause-on-hover={pauseOnHover ? 'true' : 'false'}
>
  {slides.map((s, i) => (
    <div class:list={['slide absolute inset-0', s.fit === 'contain' && 'bg-white', s.collage && 'collage', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
      {s.collage ? (
        // catalogue collage: white part cards on a faint engineering grid,
        // top row of four, the rest centred underneath
        <div
          role="img"
          aria-label={s.alt}
          class:list={['absolute inset-x-0 top-0 grid grid-cols-8 auto-rows-fr gap-1.5 sm:gap-3 px-3 pt-3 sm:px-6 sm:pt-6', controls ? 'bottom-[4.75rem] sm:bottom-[6.5rem]' : 'bottom-14 sm:bottom-[4.5rem]']}
        >
          {s.collage.map((c, k) => (
            <div
              class:list={['collage-card col-span-2 min-h-0 flex flex-col rounded-lg border border-ink-200 bg-white shadow-sm overflow-hidden', k === 4 && 'col-start-2']}
              style={`--i: ${k}`}
            >
              <div class="flex-1 min-h-0 px-2 pt-2 sm:px-4 sm:pt-3">
                <Image src={img(c.src)} alt="" width={360} loading={i === 0 ? 'eager' : 'lazy'} class="w-full h-full object-contain" />
              </div>
              <span class="flex flex-col items-center gap-1 sm:gap-1.5 px-1 pt-1 pb-1.5 sm:pt-1.5 sm:pb-2.5 text-[0.5625rem] sm:text-xs font-bold leading-tight text-ink-900 text-center">
                {c.name}
                <span class="h-0.5 w-3 sm:w-4 rounded-full bg-amber-500" aria-hidden="true"></span>
              </span>
            </div>
          ))}
        </div>
      ) : s.fit === 'contain' ? (
        // whole product on white, kept clear of the name tag and dots below
        <Image
          src={img(s.src!)}
          alt={s.alt}
          width={900}
          loading={i === 0 ? 'eager' : 'lazy'}
          class:list={['w-full h-full object-contain px-8 pt-8 sm:px-14 sm:pt-12', controls ? 'pb-20 sm:pb-24' : 'pb-14 sm:pb-18']}
        />
      ) : (
        <Image
          src={img(s.src!)}
          alt={s.alt}
          width={1000}
          height={637}
          fit="cover"
          loading={i === 0 ? 'eager' : 'lazy'}
          class="w-full h-full object-cover"
        />
      )}
      {s.label && (
        <span
          class:list={[
            'slide-label absolute left-3 sm:left-5 inline-flex items-center gap-2 rounded-md bg-ink-900/80 backdrop-blur-sm px-3 py-1.5 sm:px-4 sm:py-2 text-sm sm:text-base font-semibold text-paper',
            // no dots underneath: sit the tag in the corner
            controls ? 'bottom-10 sm:bottom-12' : 'bottom-3 sm:bottom-5',
          ]}
        >
          <span class="h-4 w-1 rounded-full bg-amber-500" aria-hidden="true"></span>{s.label}
        </span>
      )}
    </div>
  ))}

  {controls && (<>
  <div class="shade absolute inset-x-0 bottom-0 z-10 h-16 bg-gradient-to-t from-ink-900/50 to-transparent pointer-events-none"></div>
  <div class="absolute bottom-3 inset-x-0 z-10 flex justify-center gap-3">
    {slides.map((s, i) => (
      <button
        type="button"
        class:list={['dot relative size-2.5 rounded-full bg-white/50 transition-all after:absolute after:-inset-2 after:content-[""]', i === 0 && 'is-active']}
        aria-label={`Show slide ${i + 1} of ${slides.length}`}
        data-index={i}
      ></button>
    ))}
  </div>
  </>)}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.slideshow').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.dot'));
    const interval = Number(root.dataset.interval) || 4500;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      const prev = current;
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        // the outgoing slide stays fully opaque underneath while the next one
        // dissolves in on top, so the background never shows mid-fade
        s.classList.toggle('is-prev', i === prev && i !== current);
        s.classList.toggle('is-active', i === current);
        s.setAttribute('aria-hidden', i === current ? 'false' : 'true');
      });
      // light collage slide: drop the dark bottom shade, darken the dots
      root.classList.toggle('on-light', slides[current].classList.contains('collage'));
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    };
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(current + 1), interval);
    };

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.index));
        start();
      })
    );
    if (root.dataset.pauseOnHover !== 'false') {
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
    }

    new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
      { threshold: 0.3 }
    ).observe(root);
  });
</script>

<style>
  .slide {
    opacity: 0;
    z-index: 0;
    transition: opacity var(--fade, 900ms) ease-in-out;
  }
  .slide.is-prev {
    opacity: 1;
    z-index: 1;
    transition: none;
  }
  .slide.is-active {
    opacity: 1;
    z-index: 2;
  }
  /* collage: the section's light grey with a faint engineering grid */
  .slide.collage {
    background-color: #eef1f4;
    background-image:
      linear-gradient(rgb(14 17 22 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(14 17 22 / 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
  }
  /* the cards pop in one after another each time the collage comes round */
  .slide.collage.is-active .collage-card {
    animation: collage-in 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
    animation-delay: calc(var(--i) * 70ms + 150ms);
  }
  @keyframes collage-in {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.96);
    }
  }
  .shade {
    transition: opacity var(--fade, 900ms) ease-in-out;
  }
  .on-light .shade {
    opacity: 0;
  }
  .on-light .dot:not(.is-active) {
    background: rgb(14 17 22 / 0.25);
  }
  .dot.is-active {
    width: 1.5rem;
    background: #ffc629;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
    .slide.collage.is-active .collage-card {
      animation: none;
    }
  }
</style>
