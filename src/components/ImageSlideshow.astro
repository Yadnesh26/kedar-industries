---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

interface Slide {
  src: string;
  alt: string;
  /** Optional caption shown on the slide. */
  label?: string;
}
interface Props {
  slides: Slide[];
  interval?: number;
  label?: string;
  /** Thin light border around the frame (on by default; turn off on dark sections). */
  bordered?: boolean;
  /** From lg up, stretch to the height of the parent instead of a fixed aspect ratio. */
  fill?: boolean;
  /** Show the dot navigation and its bottom gradient (on by default). */
  controls?: boolean;
  /** Crossfade length in ms. */
  fadeMs?: number;
  /** Aspect-ratio utility for the frame. */
  aspect?: string;
  /** Pause while hovered or focused (on by default). Off keeps a fixed rhythm. */
  pauseOnHover?: boolean;
  class?: string;
}
const {
  slides,
  interval = 4500,
  label = 'Photo slideshow',
  bordered = true,
  fill = false,
  controls = true,
  fadeMs = 900,
  aspect = 'aspect-[1.5686]',
  pauseOnHover = true,
  class: className,
} = Astro.props;
---

<div
  class:list={['slideshow relative rounded-2xl overflow-hidden shadow-sm bg-ink-100', aspect, fill && 'lg:aspect-auto lg:h-full lg:min-h-[24rem]', bordered && 'border border-ink-100', className]}
  style={`--fade: ${fadeMs}ms`}
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-interval={interval}
  data-pause-on-hover={pauseOnHover ? 'true' : 'false'}
>
  {slides.map((s, i) => (
    <div class:list={['slide absolute inset-0', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
      <Image
        src={img(s.src)}
        alt={s.alt}
        width={1000}
        height={637}
        fit="cover"
        loading={i === 0 ? 'eager' : 'lazy'}
        class="w-full h-full object-cover"
      />
      {s.label && (
        <span
          class:list={[
            'slide-label absolute left-3 sm:left-5 inline-flex items-center gap-2 rounded-md bg-ink-900/80 backdrop-blur-sm px-3 py-1.5 sm:px-4 sm:py-2 text-sm sm:text-base font-semibold text-paper',
            // no dots underneath: sit the tag in the corner
            controls ? 'bottom-10 sm:bottom-12' : 'bottom-3 sm:bottom-5',
          ]}
        >
          <span class="h-4 w-1 rounded-full bg-amber-500" aria-hidden="true"></span>{s.label}
        </span>
      )}
    </div>
  ))}

  {controls && (<>
  <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ink-900/50 to-transparent pointer-events-none"></div>
  <div class="absolute bottom-3 inset-x-0 flex justify-center gap-3">
    {slides.map((s, i) => (
      <button
        type="button"
        class:list={['dot relative size-2.5 rounded-full bg-white/50 transition-all after:absolute after:-inset-2 after:content-[""]', i === 0 && 'is-active']}
        aria-label={`Show slide ${i + 1} of ${slides.length}`}
        data-index={i}
      ></button>
    ))}
  </div>
  </>)}
</div>

<script>
  document.querySelectorAll<HTMLElement>('.slideshow').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.dot'));
    const interval = Number(root.dataset.interval) || 4500;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      const prev = current;
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        // the outgoing slide stays fully opaque underneath while the next one
        // dissolves in on top, so the background never shows mid-fade
        s.classList.toggle('is-prev', i === prev && i !== current);
        s.classList.toggle('is-active', i === current);
        s.setAttribute('aria-hidden', i === current ? 'false' : 'true');
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    };
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(current + 1), interval);
    };

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.index));
        start();
      })
    );
    if (root.dataset.pauseOnHover !== 'false') {
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
    }

    new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
      { threshold: 0.3 }
    ).observe(root);
  });
</script>

<style>
  .slide {
    opacity: 0;
    z-index: 0;
    transition: opacity var(--fade, 900ms) ease-in-out;
  }
  .slide.is-prev {
    opacity: 1;
    z-index: 1;
    transition: none;
  }
  .slide.is-active {
    opacity: 1;
    z-index: 2;
  }
  .dot.is-active {
    width: 1.5rem;
    background: #ffc629;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>
