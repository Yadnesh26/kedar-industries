---
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

interface Slide {
  src: string;
  alt: string;
}
interface Props {
  slides: Slide[];
  interval?: number;
  label?: string;
}
const { slides, interval = 4500, label = 'Photo slideshow' } = Astro.props;
---

<div
  class="slideshow relative rounded-2xl overflow-hidden aspect-[1.5686] border border-ink-100 shadow-sm bg-ink-100"
  role="region"
  aria-roledescription="carousel"
  aria-label={label}
  data-interval={interval}
>
  {slides.map((s, i) => (
    <div class:list={['slide absolute inset-0', i === 0 && 'is-active']} aria-hidden={i === 0 ? 'false' : 'true'}>
      <Image
        src={img(s.src)}
        alt={s.alt}
        width={1000}
        height={637}
        fit="cover"
        loading={i === 0 ? 'eager' : 'lazy'}
        class="w-full h-full object-cover"
      />
    </div>
  ))}

  <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-ink-900/50 to-transparent pointer-events-none"></div>
  <div class="absolute bottom-3 inset-x-0 flex justify-center gap-3">
    {slides.map((s, i) => (
      <button
        type="button"
        class:list={['dot relative size-2.5 rounded-full bg-white/50 transition-all after:absolute after:-inset-2 after:content-[""]', i === 0 && 'is-active']}
        aria-label={`Show slide ${i + 1} of ${slides.length}`}
        data-index={i}
      ></button>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.slideshow').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.dot'));
    const interval = Number(root.dataset.interval) || 4500;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        s.classList.toggle('is-active', i === current);
        s.setAttribute('aria-hidden', i === current ? 'false' : 'true');
      });
      dots.forEach((d, i) => d.classList.toggle('is-active', i === current));
    };
    const stop = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };
    const start = () => {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(current + 1), interval);
    };

    dots.forEach((d) =>
      d.addEventListener('click', () => {
        show(Number(d.dataset.index));
        start();
      })
    );
    root.addEventListener('mouseenter', stop);
    root.addEventListener('mouseleave', start);
    root.addEventListener('focusin', stop);
    root.addEventListener('focusout', start);

    new IntersectionObserver(
      (entries) => entries.forEach((e) => (e.isIntersecting ? start() : stop())),
      { threshold: 0.3 }
    ).observe(root);
  });
</script>

<style>
  .slide {
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .slide.is-active {
    opacity: 1;
  }
  .dot.is-active {
    width: 1.5rem;
    background: #ffc629;
  }
  @media (prefers-reduced-motion: reduce) {
    .slide {
      transition: none;
    }
  }
</style>
