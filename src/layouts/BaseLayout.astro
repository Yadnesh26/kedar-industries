---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import FloatingContact from '@/components/FloatingContact.astro';
import company from '@/data/company.json';
import { Image } from 'astro:assets';
import { img } from '@/lib/images';

const logoIcon = img('logo-icon.png');
const logoIntro = img('logo-intro.png');

interface Props {
  title: string;
  description: string;
  /** Path from site root, e.g. "/about/". Used for canonical + JSON-LD. */
  path: string;
  /** Suppress the default Organization/LocalBusiness JSON-LD (rare). */
  noOrgSchema?: boolean;
  ogImage?: string;
}

const { title, description, path, noOrgSchema = false, ogImage = '/og-default.png' } = Astro.props;

const canonical = new URL(path, Astro.site).toString();
const fullTitle = title.includes('Kedar Industries') ? title : `${title} | Kedar Industries`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://kedarindustries.net/#organization',
  name: 'Kedar Industries',
  description: company.about,
  url: 'https://kedarindustries.net/',
  telephone: company.phone,
  email: company.emails[0],
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.line1}, ${company.address.line2}`,
    addressLocality: company.address.city,
    addressRegion: company.address.state,
    postalCode: company.address.postalCode,
    addressCountry: 'IN',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: company.geo.lat,
    longitude: company.geo.lng,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '08:00',
      closes: '18:00',
    },
  ],
  foundingDate: '2019-06',
  founder: {
    '@type': 'Person',
    name: company.ceo,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <link rel="canonical" href={canonical} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e1116" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site)} />
    <meta property="og:site_name" content="Kedar Industries" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site)} />

    {!noOrgSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    )}

    <!--
      Safety net for the .reveal scroll-in animation (see the IntersectionObserver
      below): if JavaScript fails to run or is disabled, .reveal content would
      otherwise stay at opacity:0 forever, hiding real page content. This
      forces it visible whenever JS isn't available to un-hide it itself.
    -->
    <noscript>
      <style>
        .reveal { opacity: 1 !important; transform: none !important; }
        #preloader { display: none !important; }
        #intro { display: none !important; }
      </style>
    </noscript>

    <slot name="head" />
  </head>
  <body class="bg-paper text-ink-600 antialiased">
    {/* One-time first-visit intro: a full black screen with the logo, shown
        only the very first time a visitor lands on the site (gated via
        localStorage). Hidden by default so returning visitors never see it
        flash — the inline script below un-hides it synchronously, before
        paint, only when no visit has been recorded yet. Sits above #preloader
        (higher z-index) so it fully covers it during the intro. */}
    <div id="intro" aria-hidden="true" style="display:none">
      <Image src={logoIntro} alt="" width={900} height={269} class="intro__logo" />
    </div>
    <script is:inline>
      (function () {
        try {
          if (!localStorage.getItem('kiIntroSeen')) {
            localStorage.setItem('kiIntroSeen', '1');
            var intro = document.getElementById('intro');
            if (intro) intro.style.display = 'flex';
          }
        } catch (e) {}
      })();
    </script>

    {/* Shown on every full page load (this is a static multi-page site, so
        each navigation is a fresh load) — fades out once the window's
        load event fires, with a timeout fallback in case that never comes. */}
    <div id="preloader" aria-hidden="true">
      <Image src={logoIcon} alt="" width={64} height={64} class="preloader__logo" />
    </div>

    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-amber-500 focus:text-ink-900 focus:px-4 focus:py-2 focus:rounded-md focus:font-semibold"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <FloatingContact />

    <script>
      // Scroll-in reveal, respecting prefers-reduced-motion (handled in CSS too).
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>

    <script>
      // Hide the first-visit intro after a fixed, short duration (not tied to
      // page load) so the branded moment is always 1–1.5s max, regardless of
      // connection speed. It sits above #preloader, so #preloader continues
      // its own normal load-based logic underneath and simply becomes visible
      // once the intro fades away (or the page is already loaded by then).
      const intro = document.getElementById('intro');
      if (intro && intro.style.display !== 'none') {
        setTimeout(() => {
          intro.classList.add('is-hidden');
          intro.addEventListener('transitionend', () => intro.remove(), { once: true });
        }, 1300);
      }
    </script>

    <script>
      // Hide the preloader once the page is actually ready (window 'load' —
      // images/fonts included, not just DOM parsing), with a hard timeout
      // fallback so a slow/failed resource can never leave it stuck forever.
      const preloader = document.getElementById('preloader');
      if (preloader) {
        let hidden = false;
        const hide = () => {
          if (hidden) return;
          hidden = true;
          preloader.classList.add('is-hidden');
          preloader.addEventListener('transitionend', () => preloader.remove(), { once: true });
        };
        window.addEventListener('load', hide);
        setTimeout(hide, 4000);
      }
    </script>
  </body>
</html>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-paper);
    transition: opacity 400ms var(--ease-out-standard), visibility 400ms var(--ease-out-standard);
  }
  #preloader.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .preloader__logo {
    width: 64px;
    height: 64px;
    animation: preloader-pulse 1.1s ease-in-out infinite;
  }
  @keyframes preloader-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(0.86);
      opacity: 0.55;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .preloader__logo {
      animation: none;
    }
    #preloader {
      transition: none;
    }
  }

  #intro {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    background: #000;
    transition: opacity 400ms var(--ease-out-standard), visibility 400ms var(--ease-out-standard);
  }
  #intro.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .intro__logo {
    width: min(70vw, 320px);
    height: auto;
    animation: intro-pop 900ms var(--ease-out-standard) both;
  }
  @keyframes intro-pop {
    0% {
      transform: scale(0.7);
      opacity: 0;
    }
    60% {
      transform: scale(1.06);
      opacity: 1;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .intro__logo {
      animation: none;
    }
    #intro {
      transition: none;
    }
  }
</style>
